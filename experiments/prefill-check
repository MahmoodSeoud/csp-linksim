#!/usr/bin/env bash
# prefill-check <readback> <sentinel> - print one clear word, so a bad pre-fill
# is caught BEFORE the expensive lossy upload.
#
# Why a script and not an inline `sh sh -c "... && ..."`: the csp_shell `sh`
# command re-joins slash's argv, so nested quoting does not survive the
# tokenizer -- slash reports "No such command" and the check silently vanishes.
if cmp -s "${1:?readback}" "${2:?sentinel}"; then
  echo "PREFILL-CLEAN"
else
  echo "PREFILL-DIRTY-INVALID"
fi
