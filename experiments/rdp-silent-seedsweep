#!/usr/bin/env bash
# rdp-silent-seedsweep [seeds...] - run the two-phase csh cell once per seed.
#
# The cell itself stays csh (rdp-silent-1-upload.csh / rdp-silent-2-verify.csh);
# this only edits the seed on the bridge line, runs the two phases, and records
# the pairing that decides the verdict:
#
#   phase 1 CLAIM   : what csh's own `upload` printed
#   phase 2 REGION  : what the region actually holds, judged after the sender died
#
# Why a sweep is needed: the RDP window is 3, so when the send loop finishes at
# most 3 packets are unacknowledged. Whether the lie appears is whether any of
# THOSE packets was dropped -- at 20% loss roughly a coin flip per seed. Retrying
# one seed re-runs the same drop schedule and learns nothing.
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSH=/home/mseo/thesis/csh/builddir/csh
UP="$REPO/experiments/rdp-silent-1-upload.csh"
CSV="$REPO/captures/rdp_csh_silent.csv"
SEEDS="${*:-1 3 4 5}"

[ -f "$CSV" ] || echo "seed,claim,region,first_bad_byte,ts" > "$CSV"
for s in $SEEDS; do
  # per-seed drop log: one shared path would leave only the last cell's, and the
  # causal question ("was the FINAL packet dropped in the cells that lied?")
  # can only be answered per cell.
  sed -i -E "s|(host-rdp-infra bridge 0.20) [0-9]+ \S+|\1 $s /tmp/hostdrops_s$s.csv|" "$UP"
  echo "===== seed $s ====="
  script -qec "$CSH -i $UP" /dev/null </dev/null 2>&1 | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r' > /tmp/ph1_s$s.log
  claim=OTHER
  grep -qa '^Uploaded 262144 bytes' /tmp/ph1_s$s.log && claim=CLAIMED_SUCCESS
  grep -qa "didn't complete" /tmp/ph1_s$s.log && claim=HONEST_ABORT
  script -qec "$CSH -i $REPO/experiments/rdp-silent-2-verify.csh" /dev/null </dev/null 2>&1 | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r' > /tmp/ph2_s$s.log
  region=UNKNOWN
  grep -qa 'DELIVERED OK' /tmp/ph2_s$s.log && region=INTACT
  grep -qa 'FILE WRONG'   /tmp/ph2_s$s.log && region=WRONG
  grep -qa 'CELL INVALID' /tmp/ph2_s$s.log && region=INVALID
  fb=$(grep -aoE 'first differing byte: [0-9]+' /tmp/ph2_s$s.log | grep -oE '[0-9]+' | head -1)
  echo "$s,$claim,$region,${fb:-NA},$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$CSV"
  echo "  seed $s: claim=$claim region=$region first_bad=${fb:-NA}"
  [ "$claim" = CLAIMED_SUCCESS ] && [ "$region" = WRONG ] && echo "  *** SILENT CORRUPTION via csh ***"
done
echo; column -t -s, "$CSV"
awk -F, 'NR>1 && $2=="CLAIMED_SUCCESS" && $3=="WRONG"{c++} END{print "\nsilent-corruption cells via csh: "c+0" / "NR-1}' "$CSV"
