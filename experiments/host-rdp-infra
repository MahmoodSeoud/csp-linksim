#!/usr/bin/env bash
# host-rdp-infra {start|bridge <loss> <seed>|stop} - the processes a csh-driven
# host-transport RDP cell needs. Called from the .csh via the csp_shell `sh`
# command, so the experiment stays ONE .csh file.
#
# Why these processes exist at all: the host transport is the regime where the
# send loop can finish before the connection dies, which is the condition the
# cell is about. can0 cannot produce it (the connection dies mid-loop and the
# uploader honestly reports short) -- that contrast is the point.
#
#   broker A (127.0.0.1) <- csh sits here as addr 26
#        |
#   ci_inject_bridge  <- the seeded loss goes here, and ONLY here
#        |
#   broker B (127.0.0.2) <- vmem_node 5431 (the receiver) sits here
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
B="$REPO/build"
GROUND_PROXY=/home/mseo/.local/bin/zmqproxy

kill_pat() { local p; p=$(ps -eo pid,args | grep -E "$1" | grep -v grep | awk '{print $1}'); for x in $p; do kill "$x" 2>/dev/null; done; }

start_bridge() {  # <loss> <seed> [droplog]
  kill_pat '[c]i_inject_bridge'
  sleep 1
  "$B/tests/e2e/ci_inject_bridge" \
    "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,5431" \
    "zmq:tcp://127.0.0.2:6000,tcp://127.0.0.2:7000" \
    14 200 8 "$1" 4 "$2" "${3:-/dev/null}" 26 0 0 >/tmp/hostrdp_bridge.log 2>&1 &
  sleep 2
  echo "infra: bridge up (loss=$1 seed=$2)"
}

case "${1:?start|bridge|stop}" in
  start)
    # The ground proxy binds 0.0.0.0:6000/7000, which blocks broker A. Stop it
    # for the run; 'stop' puts it back exactly as it was.
    kill_pat 'zmqproxy -s tcp://0.0.0.0:6000'
    kill_pat '[z]mqproxy-lossy|[e]2e/vmem_node -z|[c]i_inject_bridge'
    sleep 1
    "$B/proxy/zmqproxy-lossy" -s tcp://127.0.0.1:6000 -p tcp://127.0.0.1:7000 >/tmp/hostrdp_brokerA.log 2>&1 &
    "$B/proxy/zmqproxy-lossy" -s tcp://127.0.0.2:6000 -p tcp://127.0.0.2:7000 >/tmp/hostrdp_brokerB.log 2>&1 &
    sleep 1
    "$B/tests/e2e/vmem_node" -z 127.0.0.2 -a 5431 >/tmp/hostrdp_node.log 2>&1 &
    sleep 2
    n=$(ps -eo args | grep -cE '[z]mqproxy-lossy')
    echo "infra: brokers=$n receiver=$(grep -ac 'vmem_node up' /tmp/hostrdp_node.log) (want brokers=2 receiver=1)"
    start_bridge 0 1
    ;;
  bridge) start_bridge "${2:?loss}" "${3:?seed}" "${4:-/dev/null}" ;;
  stop)
    kill_pat '[c]i_inject_bridge|[z]mqproxy-lossy|[e]2e/vmem_node -z'
    sleep 1
    "$GROUND_PROXY" -s tcp://0.0.0.0:6000 -p tcp://0.0.0.0:7000 >/tmp/zmqproxy.log 2>&1 &
    sleep 1
    echo "infra: torn down; ground proxy restored ($(ss -ltn | grep -cE ':6000|:7000') listeners)"
    ;;
esac
