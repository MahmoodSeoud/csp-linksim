#!/usr/bin/env bash
# rdp-forcesilent-verify -- strict external verdict for rdp-forcesilent.csh.
# Called from inside the .csh via `sh`, and re-runnable standalone any time
# after a session (judges from /tmp artifacts only). The mechanism's CLAIM
# (Uploaded vs didn't complete) is on your terminal / session log -- this
# script judges what actually landed.
set -uo pipefail
PAY=/home/mseo/thesis/csp-linksim/captures/payload_256k.bin
SIZE=262144

echo "==================== VERDICT ===================="
# [1] no-prior-garbage proof: region was exactly 0xAA before the lossy upload
if cmp -s /tmp/pre.bin /tmp/sentinel_AA.bin; then
  echo "[1] PREFILL CLEAN : region was exactly 0xAA before the run"
else
  echo "[1] PREFILL DIRTY : test INVALID"; cmp /tmp/pre.bin /tmp/sentinel_AA.bin 2>&1 | head -1; exit 2
fi

# [2] what actually landed
GOT_SHA=$(sha256sum /tmp/got.bin 2>/dev/null | cut -d' ' -f1)
ORIG_SHA=$(sha256sum "$PAY" | cut -d' ' -f1)
if [ "$GOT_SHA" = "$ORIG_SHA" ]; then
  echo "[2] DELIVERED OK  : sha256 matches source (seed got lucky -- rerun with another -S)"; exit 0
fi
echo "[2] FILE WRONG    : delivered sha256 != source"
echo "    -> pair this with the upload's own words on your terminal:"
echo "       'Uploaded $SIZE bytes'  = SILENT corruption (the claim under test)"
echo "       'didn't complete'       = loud abort (honest even unkillable)"

# [3] the wrong bytes must still be the sentinel = never delivered by this upload
FIRST=$(cmp "$PAY" /tmp/got.bin 2>/dev/null | grep -oE 'byte [0-9]+' | grep -oE '[0-9]+' | head -1)
echo "    first differing byte: ${FIRST:-?} of $SIZE"
TAILHEX=$(tail -c "$((SIZE - ${FIRST:-1} + 1))" /tmp/got.bin | od -v -An -tx1 | tr -d ' \n')
if [ -n "$TAILHEX" ] && [ -z "${TAILHEX//aa/}" ]; then
  echo "[3] TAIL IS SENTINEL: every wrong byte is 0xAA -- never delivered. PROVEN."
else
  echo "[3] tail not all-0xAA -- inspect: xxd /tmp/got.bin | tail"
fi
