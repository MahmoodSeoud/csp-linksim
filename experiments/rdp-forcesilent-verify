#!/usr/bin/env bash
# rdp-forcesilent-verify [size] [payload] [pre] [got] [sentinel]
#   strict external verdict for the rdp-forcesilent cells. Defaults to the
#   256 KiB cell; the 32 KiB cell passes its own paths. Called from inside the
#   .csh via `sh`, and re-runnable standalone from the /tmp artifacts.
#
# It judges what LANDED. The mechanism's CLAIM ("Uploaded N bytes" vs "Upload
# didn't complete") is on your terminal -- the pairing is what decides silent
# vs loud, and it is spelled out below.
set -uo pipefail
SIZE="${1:-262144}"
PAY="${2:-/home/mseo/thesis/csp-linksim/captures/payload_256k.bin}"
PRE="${3:-/tmp/pre.bin}"
GOT="${4:-/tmp/got.bin}"
SENT="${5:-/tmp/sentinel_AA.bin}"

echo "==================== VERDICT ===================="
# [1] no-prior-garbage proof: region was exactly 0xAA before the lossy upload
if cmp -s "$PRE" "$SENT"; then
  echo "[1] PREFILL CLEAN : region was exactly 0xAA before the run"
else
  echo "[1] PREFILL DIRTY : test INVALID"; cmp "$PRE" "$SENT" 2>&1 | head -1; exit 2
fi

# [1b] did the read-back actually produce an artifact? A failed download leaves
# the file missing or short, and judging that as "corrupt" is a harness lie --
# the same defect class as parsing the wrong upload line. No read-back, no verdict.
GOTSZ=$(stat -c%s "$GOT" 2>/dev/null || echo 0)
if [ "$GOTSZ" != "$SIZE" ]; then
  echo "[1b] NO READ-BACK : $GOT is ${GOTSZ}B, expected ${SIZE}B (download failed?)"
  echo "     CELL INVALID -- the region was never read; nothing can be judged."
  echo "     Likely the node is still holding the aborted RDP connection: wait out"
  echo "     conn_timeout and re-read, or re-run the cell."
  exit 3
fi

# [2] what actually landed
GOT_SHA=$(sha256sum "$GOT" 2>/dev/null | cut -d' ' -f1)
ORIG_SHA=$(sha256sum "$PAY" | cut -d' ' -f1)
if [ "$GOT_SHA" = "$ORIG_SHA" ]; then
  echo "[2] DELIVERED OK  : sha256 matches source -- clean delivery this cell"
  echo "    (if the upload also claimed success, that is the CORRECT outcome)"
  exit 0
fi
echo "[2] FILE WRONG    : delivered sha256 != source"
echo "    -> pair with the upload's own words on your terminal:"
echo "       'Uploaded $SIZE bytes' = SILENT corruption (the claim under test)"
echo "       'didn't complete'      = loud abort (honest; the correct outcome)"

# [3] where, and are the wrong bytes still the sentinel (= never delivered)?
FIRST=$(cmp "$PAY" "$GOT" 2>/dev/null | grep -oE 'byte [0-9]+' | grep -oE '[0-9]+' | head -1)
echo "    first differing byte: ${FIRST:-?} of $SIZE"
if [ -n "${FIRST:-}" ]; then
  PCT=$(( 100 * FIRST / SIZE ))
  echo "    i.e. ${PCT}% of the artifact arrived before delivery stopped"
fi
TAILHEX=$(tail -c "$((SIZE - ${FIRST:-1} + 1))" "$GOT" | od -v -An -tx1 | tr -d ' \n')
if [ -n "$TAILHEX" ] && [ -z "${TAILHEX//aa/}" ]; then
  echo "[3] TAIL IS SENTINEL: every wrong byte is 0xAA -- never delivered. PROVEN."
else
  echo "[3] tail not all-0xAA -- inspect: xxd $GOT | tail"
fi
