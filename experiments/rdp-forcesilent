#!/usr/bin/env bash
# rdp-forcesilent -- prep + run + verdict around experiments/rdp-forcesilent.csh.
#
# The .csh file IS the experiment (everything that touches the bus, readable and
# replayable with plain `csh -i`). This wrapper only does what csh cannot:
# create the sentinel beforehand, and judge the outcome afterwards with checks
# external to the mechanism under test. Pattern for all bench experiments.
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSH="${CSH:-/home/mseo/thesis/csh/builddir/csh}"
PAY="$REPO/captures/payload_256k.bin"
LOG="${LOG:-/tmp/rdp_forcesilent_session.log}"

# prep: the 0xAA sentinel (known pattern -> "still 0xAA" == never delivered)
python3 -c "open('/tmp/sentinel_AA.bin','wb').write(b'\xAA'*262144)"
rm -f /tmp/pre.bin /tmp/got.bin

echo ">> csh -i experiments/rdp-forcesilent.csh  (can stall minutes under 30% loss; cap 600s)"
( cd "$REPO" && timeout 900 script -qec "$CSH -i experiments/rdp-forcesilent.csh" /dev/null </dev/null ) \
  | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r' | tee "$LOG" | grep -aE "Uploaded|didn't complete|csp_loss|Success|Failure" || true

"$REPO/experiments/rdp-forcesilent-verify"
