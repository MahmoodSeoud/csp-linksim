#!/usr/bin/env bash
# rdp-silent-try [seed...] -- run the operator csh cell once per seed and record
# what happened. The MECHANISM lives entirely in the two csh files; this only
# sequences them and echoes the lines they print.
#
#   phase 1  experiments/rdp-silent-1-upload.csh   upload under loss, exit at once
#   phase 2  experiments/rdp-silent-2-verify.csh   fresh csh reads back, prints verdict
#
# With no arguments it runs the committed cell exactly as-is (seed 4, which is
# known to corrupt often). With seeds it runs a /tmp COPY per seed -- the
# committed .csh is never touched. Every cell is APPENDED to the CSV with a run
# tag; nothing is ever overwritten.
#
# What the seed does and does not pin: the seed fixes WHICH packets the bridge
# drops, so it mostly decides whether the tail is at risk. RDP's retransmit
# timing is wall-clock, so the same seed can still land differently between
# runs. Sample across seeds; re-running one clean seed proves nothing.
#
#   experiments/rdp-silent-try              # one attempt, committed cell as-is
#   experiments/rdp-silent-try 4 6 15 16    # one attempt per seed
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSH=/home/mseo/thesis/csh/builddir/csh
CSV="$REPO/captures/rdp_csh_silent.csv"
RUN="try$(date -u +%Y%m%dT%H%M)"
strip() { sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r'; }

[ -f "$CSV" ] || echo "run,seed,claim,region,first_bad_byte,ts" > "$CSV"

run_cell() {  # <phase1.csh> <seed-label>
  local ph1="$1" s="$2" claim region fb
  script -qec "$CSH -i $ph1" /dev/null </dev/null 2>&1 | strip > /tmp/try_ph1_s$s.log
  grep -aE 'Uploaded 262144 bytes in|didn.t complete' /tmp/try_ph1_s$s.log | tail -1 | sed 's/^/  phase1: /'
  claim=OTHER
  grep -qa '^Uploaded 262144 bytes' /tmp/try_ph1_s$s.log && claim=CLAIMED_SUCCESS
  grep -qa "didn't complete"        /tmp/try_ph1_s$s.log && claim=HONEST_ABORT
  script -qec "$CSH -i $REPO/experiments/rdp-silent-2-verify.csh" /dev/null </dev/null 2>&1 | strip > /tmp/try_ph2_s$s.log
  grep -aE 'DELIVERED OK|FILE WRONG|CELL INVALID|first differing byte|SILENT CORRUPTION' /tmp/try_ph2_s$s.log | sed 's/^/  verdict: /'
  region=UNKNOWN
  grep -qa 'DELIVERED OK' /tmp/try_ph2_s$s.log && region=INTACT
  grep -qa 'FILE WRONG'   /tmp/try_ph2_s$s.log && region=WRONG
  grep -qa 'CELL INVALID' /tmp/try_ph2_s$s.log && region=INVALID
  fb=$(grep -aoE 'first differing byte: [0-9]+' /tmp/try_ph2_s$s.log | grep -oE '[0-9]+' | head -1)
  echo "$RUN,$s,$claim,$region,${fb:-NA},$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$CSV"
  [ "$claim" = CLAIMED_SUCCESS ] && [ "$region" = WRONG ] && echo "  *** SILENT CORRUPTION: csh said success over a file it did not deliver ***"
}

if [ $# -eq 0 ]; then
  echo "===== committed cell, as-is ====="
  run_cell "$REPO/experiments/rdp-silent-1-upload.csh" pinned
else
  cp "$REPO/experiments/rdp-silent-1-upload.csh" /tmp/try_upload.csh
  for s in "$@"; do
    echo "===== seed $s ====="
    sed -i -E "s|(host-rdp-infra bridge 0.20) [0-9]+ \S+|\1 $s /tmp/hostdrops_s$s.csv|" /tmp/try_upload.csh
    run_cell /tmp/try_upload.csh "$s"
  done
fi

echo
column -t -s, "$CSV" | tail -n $(( $# > 0 ? $# + 1 : 2 ))
awk -F, 'NR>1 && $3=="CLAIMED_SUCCESS" && $4=="WRONG"{c++} NR>1 && $4!="INVALID"{n++} \
  END{print "\nall-time tally: "c+0" silent / "n+0" valid cells (see '"$CSV"')"}' "$CSV"
