#!/usr/bin/env bash
# External verdict for rdp-host-silent.csh. Judges what LANDED; the CLAIM is the
# "Uploaded 262144 bytes" line csh printed above.
set -uo pipefail
PAY=/home/mseo/thesis/csp-linksim/captures/payload_256k.bin
SENT=/tmp/sentinel_256k.bin; PRE=/tmp/hostpre.bin; GOT=/tmp/hostgot.bin; SIZE=262144
echo "==================== VERDICT ===================="
[ "$(stat -c%s "$PRE" 2>/dev/null || echo 0)" = "$SIZE" ] || { echo "[1] NO PRE-FILL READ-BACK -- CELL INVALID"; exit 2; }
cmp -s "$PRE" "$SENT" && echo "[1] PREFILL CLEAN : region was exactly 0xAA before the run" \
                      || { echo "[1] PREFILL DIRTY -- CELL INVALID"; exit 2; }
[ "$(stat -c%s "$GOT" 2>/dev/null || echo 0)" = "$SIZE" ] || { echo "[2] NO READ-BACK -- CELL INVALID"; exit 3; }
if cmp -s "$GOT" "$PAY"; then
  echo "[2] DELIVERED OK  : the file arrived intact (correct outcome for this cell)"; exit 0; fi
echo "[2] FILE WRONG    : delivered file != source"
FIRST=$(cmp "$PAY" "$GOT" | grep -oE 'byte [0-9]+' | grep -oE '[0-9]+' | head -1)
echo "    first differing byte: $FIRST of $SIZE  ($(awk -v f="$FIRST" 'BEGIN{printf "%.2f%%",100*(f-1)/262144}') arrived)"
echo "    offset $((FIRST-1)) = $(( (FIRST-1)/192 )) whole packets x 192 B, remainder $(( (FIRST-1)%192 ))"
TAIL=$(tail -c "$((SIZE-FIRST+1))" "$GOT" | od -v -An -tx1 | tr -d ' \n')
if [ -z "${TAIL//aa/}" ]; then
  echo "[3] TAIL IS SENTINEL: every wrong byte is 0xAA -- those packets NEVER arrived."
  echo "    Pair with the upload line above: 'Uploaded 262144 bytes' = SILENT CORRUPTION."
else echo "[3] tail not all-0xAA -- inspect: xxd $GOT | tail"; fi
