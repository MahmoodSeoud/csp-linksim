 #define DEFAULT_TIMEOUT 360000
 
+/* The deploy wait doubles as the SVU serve window: when it expires the ground
+ * stops serving and the agent's recovery rounds go unanswered mid-transfer.
+ * On a paced link the serialization time alone can exceed the compiled
+ * default (256 KiB at 4800 bit/s is ~451 s on the wire), so the window must
+ * scale with the link, not with the binary. SATDEPLOY_PUSH_TIMEOUT_MS
+ * overrides it; unset keeps the compiled default. */
+static uint32_t push_timeout_ms(void)
+{
+    const char *s = getenv("SATDEPLOY_PUSH_TIMEOUT_MS");
+    if (s && *s) {
+        char *end = NULL;
+        unsigned long v = strtoul(s, &end, 10);
+        if (end && *end == '\0' && v > 0 && v <= 86400000UL)
+            return (uint32_t)v;
+    }
+    return DEFAULT_TIMEOUT;
+}
+
