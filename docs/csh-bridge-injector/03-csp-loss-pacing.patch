+/*
+ * Harness health: scan /proc for processes that silently invalidate a cell.
+ *
+ * The expensive failure this catches is specific. An upload_gs-server attached to
+ * the CAN bus (-c can0) answers the on-board client directly on the shared bus, so
+ * the transfer never crosses this injector: the drop counters stay at zero, the
+ * delivered file looks however the unpaced bus left it, and the run reads as
+ * lossless. Nothing in CSP can detect that from the network, so it is checked here,
+ * at the moment the injector is armed. A second injector (ci_inject_bridge, or
+ * another bridging csh) is the same class of fault: both forward, every frame is
+ * duplicated, and the imposed loss is no longer the loss that reached the board.
+ *
+ * Reports, never refuses: an operator exploring a link is a legitimate caller, and
+ * a warning they can read beats a policy that blocks them. `csp_loss status` repeats
+ * the scan so a session can be re-checked without re-arming.
+ */
+static size_t loss_read_cmdline(const char *pid, char *buf, size_t buflen)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%s/cmdline", pid);
+    FILE *f = fopen(path, "r");
+    if (f == NULL) {
+        return 0;
+    }
+    size_t n = fread(buf, 1, buflen - 1, f);
+    fclose(f);
+    if (n == 0) {
+        return 0;
+    }
+    buf[n] = '\0';
+    return n;   /* left NUL-separated: argv[0] must be matched on its own */
+}
+
+/* Match on the executable's basename, not on a substring of the whole command
+ * line: a wrapper shell whose arguments merely mention "upload_gs-server" is not
+ * a ground server, and counting it would make the warning cry wolf. */
+static int loss_argv0_is(const char *cmd, const char *want)
+{
+    const char *slash = strrchr(cmd, '/');
+    const char *base = slash ? slash + 1 : cmd;
+    return strcmp(base, want) == 0;
+}
+
+/* Does any argument after argv[0] equal "-c"? (bus-attached ground server) */
+static int loss_has_arg(const char *buf, size_t n, const char *want)
+{
+    size_t i = strlen(buf) + 1;   /* skip argv[0] */
+    while (i < n) {
+        if (strcmp(buf + i, want) == 0) {
+            return 1;
+        }
+        i += strlen(buf + i) + 1;
+    }
+    return 0;
+}
+
+static void loss_scan_conflicts(void)
+{
+    DIR *proc = opendir("/proc");
+    if (proc == NULL) {
+        return;
+    }
+
+    int gs_can = 0, gs_total = 0, other_injectors = 0;
+    char gs_can_cmd[256] = {0};
+    pid_t self = getpid();
+    struct dirent *e;
+
+    while ((e = readdir(proc)) != NULL) {
+        if (!isdigit((unsigned char)e->d_name[0])) {
+            continue;
+        }
+        if ((pid_t)atoi(e->d_name) == self) {
+            continue;
+        }
+        char cmd[512];
+        size_t n = loss_read_cmdline(e->d_name, cmd, sizeof(cmd));
+        if (n == 0) {
+            continue;
+        }
+        if (loss_argv0_is(cmd, "upload_gs-server")) {
+            gs_total++;
+            if (loss_has_arg(cmd, n, "-c")) {
+                gs_can++;
+                if (gs_can_cmd[0] == '\0') {
+                    /* cmd is NUL-separated, so this prints argv[0] only, which
+                     * is what the operator needs to identify the process. */
+                    snprintf(gs_can_cmd, sizeof(gs_can_cmd), "pid %.10s: %.200s",
+                             e->d_name, cmd);
+                }
+            }
+        }
+        if (loss_argv0_is(cmd, "ci_inject_bridge")) {
+            other_injectors++;
+        }
+    }
+    closedir(proc);
+
+    if (gs_can > 0) {
+        printf("csp_loss: WARNING a ground server is attached to the bus and will bypass this injector:\n");
+        printf("csp_loss:   %s\n", gs_can_cmd);
+        printf("csp_loss:   it answers the on-board client directly, so this cell measures nothing.\n");
+        printf("csp_loss:   run the server on ZMQ instead (-z 127.0.0.1) and re-arm.\n");
+    }
+    if (gs_total > 1) {
+        printf("csp_loss: WARNING %d upload_gs-server processes are running; the client will be\n", gs_total);
+        printf("csp_loss:   answered by whichever replies first. Leave exactly one.\n");
+    }
+    if (other_injectors > 0) {
+        printf("csp_loss: WARNING %d ci_inject_bridge process(es) running; two injectors on one\n", other_injectors);
+        printf("csp_loss:   path duplicate every frame. Stop one.\n");
+    }
+    if (gs_can == 0 && gs_total <= 1 && other_injectors == 0) {
+        printf("csp_loss: bus check clean (%d ground server%s, no competing injector)\n",
+               gs_total, gs_total == 1 ? "" : "s");
+    }
+}
+
