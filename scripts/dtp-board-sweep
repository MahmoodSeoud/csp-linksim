#!/usr/bin/env bash
# dtp-board-sweep - the pre-registered T1 grid: the DEPLOYED uploader at FLIGHT
# pacing (4800 bit/s) on the payload board, judged by the board-side sha256.
#
# This is the matrix's one unmeasured row. The design doc pre-registers all three
# outcomes before the data is read:
#   (a) silent corruption at 4800  -> the claim stands at full strength
#   (b) loud failure at 4800       -> the regime-flip generalises to two transports
#   (c) correct delivery at 4800   -> the finding narrows honestly to fast links
#
# Each cell is ~7.4 min of airtime (256 KiB at 4800 bit/s) plus settle, so budget
# ~10 min/cell. Resumable: a cell already in the CSV is skipped.
#
# Usage: dtp-board-sweep [losses] [nseeds]      default: "0 0.10 0.30" 3
#        BURST_CELLS=1 dtp-board-sweep          adds the GE burst point (7.8)
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSV="${CSV:-$REPO/captures/dtp_flight_sweep.csv}"
LOSSES="${1:-0 0.10 0.30}"; NSEEDS="${2:-3}"
RATE_BPS="${RATE_BPS:-4800}"

[ -f "$CSV" ] || echo "loss,seed,burst,rate_bps,sent,kept,dropped,realized,observed,total,completion,drop_obs,sha,board_bytes,label,ts" > "$CSV"

run_cell() {
  local loss="$1" seed="$2" burst="$3"
  local tag; tag=$(echo "$loss" | tr -d '.'); local label="dtp${RATE_BPS}_L${tag}_b${burst}_s${seed}"
  if awk -F, -v l="$loss" -v s="$seed" -v b="$burst" 'NR>1&&$1==l&&$2==s&&$3==b{f=1}END{exit !f}' "$CSV"; then
    echo "-- $label already recorded, skipping"; return 0; fi

  echo "== $label =="
  local out="/tmp/${label}.out"
  STRICT_SHA=1 RATE_BPS="$RATE_BPS" BURST="$burst" bash "$REPO/scripts/dtp-board-point" "$loss" "$seed" "$label" > "$out" 2>&1
  local rc=$?
  if [ $rc -ne 0 ]; then echo "   FAILED (rc=$rc), not recorded:"; tail -3 "$out"; return 1; fi

  # Parse the cell block. Anchor every field to its own line: taking a value from
  # the wrong line is the defect that produced a bogus verdict class earlier in
  # this campaign, so nothing here is matched loosely.
  local sent kept dropped realized observed total compl drop_obs sha
  sent=$(grep -aoE 'sent_unique=[0-9]+' "$out" | grep -oE '[0-9]+' | head -1)
  kept=$(grep -aoE 'kept=[0-9]+' "$out" | grep -oE '[0-9]+' | head -1)
  dropped=$(grep -aoE 'dropped=[0-9]+' "$out" | grep -oE '[0-9]+' | head -1)
  realized=$(grep -aoE 'realized=[0-9.]+' "$out" | grep -oE '[0-9.]+' | head -1)
  observed=$(grep -aoE 'observed_unique=[0-9]+' "$out" | grep -oE '[0-9]+' | head -1)
  total=$(grep -aoE 'file=[0-9]+ frags' "$out" | grep -oE '[0-9]+' | head -1)
  compl=$(grep -a 'COMPLETION' "$out" | grep -oE '[0-9.]+%' | head -1)
  drop_obs=$(grep -aoE 'dropped&observed=[0-9]+' "$out" | grep -oE '[0-9]+' | head -1)
  sha=$(grep -a 'EXTERNAL CHECK' "$out" | grep -oE '(MISMATCH|MATCH|ABSENT|UNVERIFIED)' | head -1)
  bsize=$(grep -a 'EXTERNAL CHECK' "$out" | grep -oE 'board_bytes=[0-9NA]+' | cut -d= -f2)

  # UNVERIFIED = the console did not answer -> harness fault, cell void.
  # ABSENT      = the console answered, no file -> a real "delivered nothing" cell.
  if [ "${sha:-}" = "UNVERIFIED" ] || [ -z "${sha:-}" ]; then
    echo "   console did not answer -- cell NOT recorded (STRICT_SHA discipline)"; return 1; fi

  echo "$loss,$seed,$burst,$RATE_BPS,${sent:-NA},${kept:-NA},${dropped:-NA},${realized:-NA},${observed:-NA},${total:-NA},${compl:-NA},${drop_obs:-NA},$sha,${bsize:-NA},$label,$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$CSV"
  echo "   -> realized=$realized completion=$compl board_sha=$sha"
}

for loss in $LOSSES; do
  for s in $(seq 1 "$NSEEDS"); do run_cell "$loss" "$s" 4; done
done
if [ "${BURST_CELLS:-0}" = "1" ]; then
  for s in $(seq 1 "$NSEEDS"); do run_cell 0.10 "$s" 7.8; done
fi

echo; echo "== $CSV =="; column -t -s, "$CSV"
echo
echo "SILENT CORRUPTION (delivered-but-wrong) cells:"
awk -F, 'NR>1{n++; if($13=="MISMATCH")m++; if($13=="MATCH")k++; if($13=="ABSENT")a++}
     END{printf "  MISMATCH(silent corruption)=%d  MATCH(clean)=%d  ABSENT(nothing delivered)=%d  of %d cells\n",m+0,k+0,a+0,n+0}' "$CSV"
