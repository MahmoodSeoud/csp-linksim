#!/usr/bin/env bash
#
# rdp-zmq-sweep - the RDP+CRC32 reference arm over a pure-ZMQ path. No CAN bus, no flatsat,
# no built csh.
#
# WHY THIS EXISTS
# The reference arm is the control that localizes the silent-corruption finding to the DTP
# data plane: both paths carry the same CSP packets under the same seeded loss, and only the
# reliable one refuses to deliver a wrong file. Until now that arm could only run on the
# bench host, because it was driven through csh's `upload` over can0. csh's `upload` is a
# thin wrapper over libparam's vmem_upload(), which connects CSP_O_RDP | CSP_O_CRC32
# (subprojects/param/src/vmem/vmem_client.c:133), so rdp_push calls that API directly and
# the arm becomes reproducible on any laptop.
#
#   rdp_push -z 127.0.0.1 (addr 26) -> broker A -> ci_inject_bridge -> broker B -> vmem_node
#                                        (drops forward RDP packets to dport 14 = oracle A)
#
# Two brokers on loopback aliases, bridged by the injector, exactly as svu-zmq-sweep does.
# The injector impersonates the NODE on side A so traffic addressed to it is routed inward.
#
# THREE ORACLES PER CELL (the thesis's oracle design, Section sec:method-oracles)
#   A  the injector's drop log            - what the fault actually was
#   B  the mechanism's own verdict        - did vmem_upload report success
#   C  download-back + sha256 vs source   - what actually landed, computed outside the
#                                           mechanism.  AUTHORITATIVE.
# SILENT CORRUPTION == claimed DELIVERED & sha MISMATCH. For this path, expected: never.
# A FAILED upload is a CORRECT outcome here; the arm's claim is that it never lies.
#
# The fill and read-back phases run through the same bridge with loss forced to 0, so the
# verify path carries no injected loss while the topology stays identical. The region is
# pre-filled with zeros first, so a partial upload cannot false-pass on stale correct bytes.
#
# TRANSPORT CAVEAT (read before citing these numbers)
# Frame counts are CSP packets on ZMQ. On the can0 path each CSP packet fragments into many
# CAN frames, so FRAME counts are not comparable against a can0 run. Delivery verdicts
# (claimed, sha) ARE comparable: they are properties of the mechanism, not the link. The CSV
# records transport= so the two cannot be mixed up.
#
# Usage: rdp-zmq-sweep ["0 0.02 0.05 0.10 0.20 0.30"] [nseeds]
# Resumable: an already-recorded (loss, seed) is skipped.
set -uo pipefail

LOSSES="${LOSSES:-${1:-0 0.02 0.05 0.10 0.20 0.30}}"
NSEEDS="${NSEEDS:-${2:-3}}"
CLI_ADDR=26; NODE=5431; DPORT=14          # VMEM_PORT_SERVER
MTU="${MTU:-200}"; OVH="${OVH:-8}"; BURST="${BURST:-4}"
HD_RATE="${HD_RATE:-0}"                   # integrity is rate-independent; default unpaced
PBYTES="${PBYTES:-262144}"                # 256 KiB, the size the other arms use
PAYLOAD_SEED="${PAYLOAD_SEED:-20260729}"  # same seed as svu-zmq-sweep => same payload bytes
VADDR="${VADDR:-0x10000000}"              # must match vmem_node's BIGMEM_VADDR
UP_TO="${UP_TO:-120000}"                  # vmem_upload timeout, ms
SETTLE="${SETTLE:-3}"                     # seconds to let the receiver finalize before read-back

BUILD="${BUILD:-/build}"
REPO="${REPO:-/src}"
CAP="$REPO/captures"
CSV="${CSV:-$CAP/rdp_zmq_sweep.csv}"
PROXY="$BUILD/proxy/zmqproxy-lossy"
INJ="$BUILD/tests/e2e/ci_inject_bridge"
NODEBIN="$BUILD/tests/e2e/vmem_node"
PUSH="$BUILD/tests/e2e/rdp_push"

for b in "$PROXY" "$INJ" "$NODEBIN" "$PUSH"; do
    [ -x "$b" ] || { echo "FAIL: missing $b (run: scripts/bench build)"; exit 1; }
done
mkdir -p "$CAP"

# Deterministic payload, identical to svu-zmq-sweep's so the two arms move the same bytes.
IN=/tmp/svu_zmq_payload_${PBYTES}_${PAYLOAD_SEED}.bin
if [ "$(stat -c%s "$IN" 2>/dev/null || echo 0)" != "$PBYTES" ]; then
    python3 -c "
import random, sys
r = random.Random($PAYLOAD_SEED)
sys.stdout.buffer.write(bytes(r.getrandbits(8) for _ in range($PBYTES)))
" > "$IN" || exit 1
fi
IN_SHA=$(sha256sum "$IN" | cut -d' ' -f1)
echo "rdp-zmq-sweep: payload=${PBYTES}B sha256=${IN_SHA}"
echo "  losses=[$LOSSES] nseeds=$NSEEDS mtu=$MTU burst=$BURST hd_rate=$HD_RATE vaddr=$VADDR"
echo "  csv=$CSV"

[ -f "$CSV" ] || echo "loss,seed,injected,dropped,claimed,sha,size,transport,payload_sha256,ts" > "$CSV"

cleanup_procs() {
    pkill -f 'vmem_node' 2>/dev/null
    pkill -f 'ci_inject_bridge' 2>/dev/null
    pkill -f 'zmqproxy-lossy' 2>/dev/null
    sleep 0.5
}
trap 'cleanup_procs; exit 130' INT TERM

# start_bridge <loss> <seed> <oracle-csv> <logfile> [rate_bps] -> echoes the pid
# Rate defaults to 0 (unpaced) so the fill and read-back phases stay fast; only the measured
# upload is charged airtime. Pacing the verify path would cost wall-clock and buy nothing,
# since it carries no injected loss.
start_bridge() {
    local loss="$1" seed="$2" ora="$3" log="$4" rate="${5:-0}"
    "$INJ" "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,$NODE" \
           "zmq:tcp://127.0.0.2:6000,tcp://127.0.0.2:7000" \
           $DPORT "$MTU" "$OVH" "$loss" "$BURST" "$seed" "$ora" $CLI_ADDR 0 "$rate" >"$log" 2>&1 &
    echo $!
}
stop_bridge() {
    local pid="$1"
    kill -INT "$pid" 2>/dev/null; sleep 0.3
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
}

for loss in $LOSSES; do
  for s in $(seq 1 "$NSEEDS"); do
    if awk -F, -v l="$loss" -v sd="$s" 'NR>1 && $1==l && $2==sd {found=1} END{exit !found}' "$CSV"; then
        echo "[L${loss}_s${s}] already recorded, skipping"
        continue
    fi
    # RUN_TAG keeps oracle logs from different experiments out of each other's way. Without
    # it a paced 32 KiB rate-comparison cell overwrites the 256 KiB sweep cell's drop log,
    # destroying oracle A for a result the thesis cites.
    L="rdpz_${RUN_TAG:-p${PBYTES}r${HD_RATE}}_L${loss}_s${s}"
    ORA="$CAP/${L}_oracleA.csv"; GOT="/tmp/${L}_got.bin"
    rm -f "$GOT" "$ORA"
    cleanup_procs

    "$PROXY" -s tcp://127.0.0.1:6000 -p tcp://127.0.0.1:7000 >/tmp/${L}_brokerA.log 2>&1 &
    "$PROXY" -s tcp://127.0.0.2:6000 -p tcp://127.0.0.2:7000 >/tmp/${L}_brokerB.log 2>&1 &
    sleep 1

    "$NODEBIN" -z 127.0.0.2 -a $NODE >/tmp/${L}_node.log 2>&1 &
    for i in $(seq 1 80); do grep -qi 'vmem_node up' /tmp/${L}_node.log 2>/dev/null && break; sleep 0.1; done

    # 1) CLEAN pre-fill with zeros, so a partial upload cannot pass on stale correct bytes.
    BP=$(start_bridge 0 "$s" /dev/null /tmp/${L}_fill_inj.log); sleep 2
    fill_out=$(timeout 300 "$PUSH" -m fill -z 127.0.0.1 -a $CLI_ADDR -n $NODE \
                    -A "$VADDR" -l "$PBYTES" -t "$UP_TO" 2>&1)
    fill_rc=$?
    stop_bridge "$BP"
    if [ $fill_rc -ne 0 ]; then
        echo "[$L] FAIL: clean pre-fill did not complete (stale-data risk) - cell invalid"
        echo "$fill_out" | tail -3
        cleanup_procs
        continue
    fi

    # 2) MEASURED upload through the lossy bridge (oracle A records the fault).
    BP=$(start_bridge "$loss" "$s" "$ORA" /tmp/${L}_inj.log "$HD_RATE"); sleep 2
    up_out=$(timeout "${CELL_TIMEOUT:-900}" "$PUSH" -m upload -z 127.0.0.1 -a $CLI_ADDR -n $NODE \
                  -f "$IN" -A "$VADDR" -t "$UP_TO" 2>&1)
    up_rc=$?
    stop_bridge "$BP"
    claimed=FAILED; [ $up_rc -eq 0 ] && claimed=DELIVERED
    sleep "$SETTLE"   # let the RDP connection on the node tear down before the clean read-back

    # 3) CLEAN read-back: the external sha256 oracle, computed outside the mechanism.
    BP=$(start_bridge 0 "$s" /dev/null /tmp/${L}_dl_inj.log); sleep 2
    sha=MISMATCH; gsz=0
    for _dl in 1 2; do
        if timeout 300 "$PUSH" -m download -z 127.0.0.1 -a $CLI_ADDR -n $NODE \
                -o "$GOT" -A "$VADDR" -l "$PBYTES" -t "$UP_TO" >/tmp/${L}_dl.log 2>&1; then
            got=$(sha256sum "$GOT" 2>/dev/null | cut -d' ' -f1)
            gsz=$(stat -c%s "$GOT" 2>/dev/null || echo 0)
            [ "$got" = "$IN_SHA" ] && { sha=MATCH; break; }
            break
        fi
        sleep 2
    done
    stop_bridge "$BP"
    cleanup_procs

    inj=$(awk -F, '!/^#/{c++} END{print c+0}' "$ORA" 2>/dev/null)
    drp=$(awk -F, '!/^#/ && $8==1{c++} END{print c+0}' "$ORA" 2>/dev/null)
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    warn=""
    [ "$claimed" = DELIVERED ] && [ "$sha" = MISMATCH ] && warn="  *** SILENT CORRUPTION ***"
    echo "$loss,$s,${inj:-0},${drp:-0},$claimed,$sha,$gsz,zmq,$IN_SHA,$ts" >> "$CSV"
    echo "[$L] claimed=$claimed sha=$sha inj=${inj:-0} drop=${drp:-0}$warn"
  done
done

echo
echo "=== $CSV ==="
column -t -s, "$CSV" 2>/dev/null || cat "$CSV"
echo
echo "--- completion (DELIVERED per cell) ---"
awk -F, 'NR>1{n++; if($5=="DELIVERED") d++} END{print d+0"/"n+0" DELIVERED"}' "$CSV"
echo "--- silent corruption (DELIVERED & sha MISMATCH, expect 0) ---"
awk -F, 'NR>1 && $5=="DELIVERED" && $6=="MISMATCH"{c++} END{print c+0}' "$CSV"
echo "--- loud failures (FAILED, a correct outcome for this path) ---"
awk -F, 'NR>1 && $5=="FAILED"{c++} END{print c+0}' "$CSV"
