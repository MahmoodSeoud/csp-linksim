#!/usr/bin/env bash
#
# rdp-rate-compare - does the RDP reference path's failure MODE depend on the link rate?
#
# THE CLAIM UNDER TEST
# The evaluation reports that the reliable path reports success over a truncated tail at high
# loss (measured at line rate on a ZMQ path), while the June bench runs on can0 instead ended
# in a loud abort. Two different topologies, so the comparison is weak: it cannot separate
# "slow link" from "different transport".
#
# This script removes that confound. Same topology, same seeds, same drop schedule, same code.
# The ONLY variable is the injector's half-duplex airtime model: unpaced (line rate) against
# a paced run charging every frame its real on-air time at the flight uplink bit rate.
#
#   H-rate:  the defect is in vmem_upload's completion test and is rate-independent, but its
#            MANIFESTATION is not. Fast link -> the connection survives the send loop, so the
#            tail is silently truncated (DELIVERED + sha MISMATCH). Slow link -> the
#            connection expires before the loop finishes (FAILED, a loud and correct outcome).
#
# If that holds, the threats-section caveat becomes a controlled result, reproducible on any
# laptop with no CAN bus and no flatsat.
#
# Payload defaults to 32 KiB rather than the 256 KiB the arms use, purely to keep the paced
# cells tractable: 256 KiB at 4800 bit/s is over seven minutes of airtime per direction
# BEFORE any retransmission. The failure mode is what is under test here, not the cell count.
#
# Usage: rdp-rate-compare [loss] [nseeds] [rate_bps]
#        rdp-rate-compare 0.30 3 4800
set -uo pipefail

LOSS="${1:-0.30}"
NSEEDS="${2:-3}"
RATE="${3:-4800}"                       # flight uplink bit rate
PBYTES="${PBYTES:-32768}"               # 32 KiB, so paced cells finish in minutes

REPO="${REPO:-/src}"
CAP="$REPO/captures"
FAST="$CAP/rate_fast_L${LOSS}.csv"
SLOW="$CAP/rate_slow_${RATE}_L${LOSS}.csv"

echo "======================================================================"
echo "RDP failure mode vs link rate"
echo "  loss=$LOSS  seeds=1..$NSEEDS  payload=${PBYTES}B"
echo "  arm A: unpaced (line rate)"
echo "  arm B: paced at ${RATE} bit/s, half-duplex, both directions"
echo "======================================================================"
echo

echo "--- arm A: unpaced ---"
LOSSES="$LOSS" NSEEDS="$NSEEDS" PBYTES="$PBYTES" HD_RATE=0 CSV="$FAST" \
    CELL_TIMEOUT=900 "$REPO/scripts/rdp-zmq-sweep"

echo
echo "--- arm B: paced at ${RATE} bit/s ---"
LOSSES="$LOSS" NSEEDS="$NSEEDS" PBYTES="$PBYTES" HD_RATE="$RATE" CSV="$SLOW" \
    CELL_TIMEOUT=3600 "$REPO/scripts/rdp-zmq-sweep"

echo
echo "======================================================================"
echo "COMPARISON  (same seeds, same drops, only the link rate differs)"
echo "======================================================================"
printf '%-6s | %-28s | %-28s\n' "seed" "unpaced" "paced ${RATE} bit/s"
printf '%-6s-+-%-28s-+-%-28s\n' "------" "----------------------------" "----------------------------"
for s in $(seq 1 "$NSEEDS"); do
    a=$(awk -F, -v sd="$s" 'NR>1 && $2==sd {printf "%s / sha %s", $5, $6}' "$FAST" 2>/dev/null)
    b=$(awk -F, -v sd="$s" 'NR>1 && $2==sd {printf "%s / sha %s", $5, $6}' "$SLOW" 2>/dev/null)
    printf '%-6s | %-28s | %-28s\n' "$s" "${a:-(none)}" "${b:-(none)}"
done
echo
echo "Reading it:"
echo "  DELIVERED / sha MISMATCH = silent corruption (the mechanism lied)"
echo "  FAILED    / sha MISMATCH = loud failure      (the correct outcome)"
echo "  DELIVERED / sha MATCH    = clean delivery"
echo
sc_fast=$(awk -F, 'NR>1 && $5=="DELIVERED" && $6=="MISMATCH"{c++} END{print c+0}' "$FAST" 2>/dev/null)
sc_slow=$(awk -F, 'NR>1 && $5=="DELIVERED" && $6=="MISMATCH"{c++} END{print c+0}' "$SLOW" 2>/dev/null)
lf_fast=$(awk -F, 'NR>1 && $5=="FAILED"{c++} END{print c+0}' "$FAST" 2>/dev/null)
lf_slow=$(awk -F, 'NR>1 && $5=="FAILED"{c++} END{print c+0}' "$SLOW" 2>/dev/null)
echo "  unpaced : $sc_fast silent corruption, $lf_fast loud failure"
echo "  paced   : $sc_slow silent corruption, $lf_slow loud failure"
echo "======================================================================"
