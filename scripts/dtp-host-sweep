#!/usr/bin/env bash
#
# dtp-host-sweep - the deployed-uploader arm over a pure-ZMQ path. No CAN bus, no payload
# board, no built csh.
#
# WHY THIS EXISTS
# This is the arm that carries the thesis's headline result, and until now it was the only
# one a reader could not re-derive: it needed DISCO's upload_gs-server and upload_client on
# the flatsat, plus csh with the uploader APM to fire the transfer. All three dependencies
# are removed here:
#
#   * The two uploader ends are built FROM SOURCE out of the DISCOSAT tree. They are mission
#     code and are deliberately NOT vendored into this repository; point DISCO_SRC at a
#     checkout. Their only external deps (libprotobuf-c, libssl) are in docker/Dockerfile.bench.
#   * csh and the APM are replaced by tests/e2e/dtp_trigger, which reproduces the single
#     packet `upload_file` puts on the wire. Same move rdp_push made for the reliable path.
#   * The CAN segment is replaced by two brokers on loopback aliases, exactly as
#     svu-host-sweep does, because both uploader ends already support -z (the vendor's own
#     run-server.sh / run-client.sh use -z localhost; this is their dev configuration).
#
#   upload_gs-server -z 127.0.0.1 -> broker A -> ci_inject_bridge -> broker B -> upload_client
#                                       (drops DTP data frames, dport 8 = oracle A)
#
# TRANSPORT AND RATE CAVEAT (read before citing these numbers)
# Frame counts here are CSP packets on ZMQ and are not comparable to can0 frame counts.
# Delivery verdicts (size, sha) ARE comparable: they are properties of the mechanism.
# Set HD_RATE to charge half-duplex airtime; the committed board cells ran at 9600 bit/s,
# so HD_RATE=9600 reproduces their pacing and HD_RATE=4800 runs at the flight uplink rate.
#
# TWO PROPERTIES OF THE CLIENT THAT SHAPE THIS SCRIPT
# 1. Its idle timeout is 16 seconds, and not by design. upload_sat-client/src/main.c sets
#    `opts->timeout = 10000` as an unsigned int, but dtp_client_main takes it as a uint8_t
#    (dtp.h:283), so it truncates to 16; dtp_client.c then loops on
#    `idle_ms <= (session->timeout * 1000)` = 16000 ms. Observed exactly: the client logs
#    "No data received for 16000 ms" and exits on the next tick.
# 2. Its status is initialised to success. `dtp_result result = DTP_OK` at dtp_client.c:104
#    is only ever reassigned in the csp_bind failure branch, so after bailing out it logs
#    e.g. "Received 242740 bytes, last seq: 1040, status: 0" -- its own short byte count
#    next to a success verdict. That line IS the silent corruption, in the mechanism's
#    own words.
# Note the delivered file's SIZE is useless as a completion signal: the client preallocates
# it to full length on the first packet, so a short transfer still leaves a 262144-byte
# file. The driver watches the client's received-bytes progress counter instead.
#
# Per cell: pre-fill nothing (the client creates the destination fresh), run the transfer
# through the injector, then an EXTERNAL sha256 decides delivery.
#   SILENT CORRUPTION == full-size delivery, no loud failure, and sha MISMATCH.
#
# Usage: dtp-host-sweep ["0 0.02 0.05 0.10 0.20 0.30"] [nseeds]
# Resumable: an already-recorded (loss, seed) is skipped.
set -uo pipefail

LOSSES="${LOSSES:-${1:-0 0.02 0.05 0.10 0.20 0.30}}"
NSEEDS="${NSEEDS:-${2:-5}}"
SRV_ADDR=5424; CLI_ADDR=5426; TRIG_ADDR=5425; DPORT=8
MTU="${MTU:-256}"; OVH="${OVH:-4}"; BURST="${BURST:-4}"
HD_RATE="${HD_RATE:-0}"
PBYTES="${PBYTES:-262144}"          # 256 KiB, the size the other arms use
PAYLOAD_SEED="${PAYLOAD_SEED:-20260729}"
SETTLE="${SETTLE:-5}"               # seconds after the server finishes, before read-back
WINDOW="${WINDOW:-120}"             # max seconds to observe one cell

. "$(dirname "$0")/lib/host-sweep-lib.sh"
DISCO_SRC="${DISCO_SRC:-/disco}"
DISCO_BUILD="${DISCO_BUILD:-/tmp/disco-build}"
CSV="${CSV:-$CAP/dtp_zmq_sweep.csv}"
TRIG="$BUILD/tests/e2e/dtp_trigger"
SRV="$DISCO_BUILD/gs-server/upload_gs-server"
CLI="$DISCO_BUILD/sat-client/upload_client"
SWEEP_PROCS="upload_gs-server upload_client"

sweep_require "$PROXY" "$INJ" "$TRIG"
[ -d "$DISCO_SRC/upload_gs-server" ] || {
    echo "FAIL: no upload_gs-server under DISCO_SRC=$DISCO_SRC"
    echo "      This arm builds DISCO's mission sources, which are not vendored here."
    echo "      Mount the tree and set DISCO_SRC (scripts/bench does not mount it by default)."
    exit 1
}

# Build the two uploader ends once. Kept out of the csp-intercept build tree entirely:
# separate meson projects, separate build dirs, nothing written into /build.
build_disco() {
    local src="$1" dst="$2" name="$3"
    if [ -x "$dst/$name" ]; then return 0; fi
    echo "[dtp-host-sweep] building $name ..."
    meson setup "$dst" "$src" >/dev/null 2>&1 || \
        meson setup --reconfigure "$dst" "$src" >/dev/null 2>&1 || {
            echo "FAIL: meson setup $name"; return 1; }
    ninja -C "$dst" >/dev/null 2>&1 || { echo "FAIL: ninja $name"; return 1; }
}
build_disco "$DISCO_SRC/upload_gs-server"  "$DISCO_BUILD/gs-server"  upload_gs-server || exit 1
build_disco "$DISCO_SRC/upload_sat-client" "$DISCO_BUILD/sat-client" upload_client   || exit 1

# Deterministic payload, same seed and size as the SVU and RDP laptop arms so the three are
# byte-comparable with each other. Note they are NOT byte-comparable with the board cells,
# which used the pinned captures/payload_256k.bin (not in this repo). The server hardcodes
# fopen("file.bin") relative to its cwd, so the shared payload is copied into its dir.
sweep_payload "$PBYTES" "$PAYLOAD_SEED"
SRVDIR=/tmp/dtp_srvdir
mkdir -p "$SRVDIR"
cp -f "$IN" "$SRVDIR/file.bin"
echo "dtp-host-sweep: payload=${PBYTES}B sha256=${IN_SHA}"
echo "  losses=[$LOSSES] nseeds=$NSEEDS mtu=$MTU ovh=$OVH burst=$BURST hd_rate=$HD_RATE"
echo "  csv=$CSV"

[ -f "$CSV" ] || echo "loss,seed,injected,dropped,client_verdict,bytes,sha,size,transport,rate_bps,harness,payload_sha256,ts" > "$CSV"

sweep_trap

for loss in $LOSSES; do
  for s in $(seq 1 "$NSEEDS"); do
    if sweep_cell_recorded "$CSV" "$loss" "$s"; then
        echo "[L${loss}_s${s}] already recorded, skipping"
        continue
    fi
    L="dtpz_L${loss}_s${s}"
    ORA="$CAP/${L}_oracleA.csv"; OUT="/tmp/${L}_out.bin"
    SRVLOG="/tmp/${L}_srv.log"; CLILOG="/tmp/${L}_cli.log"; ILOG="/tmp/${L}_inj.log"
    rm -f "$OUT" "$ORA"
    sweep_cleanup
    sweep_start_brokers "$L"

    ( cd "$SRVDIR" && "$SRV" -z 127.0.0.1 -a $SRV_ADDR >"$SRVLOG" 2>&1 & )
    "$CLI" -z 127.0.0.2 -a $CLI_ADDR -s $SRV_ADDR >"$CLILOG" 2>&1 &
    sleep 2

    "$INJ" "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,$CLI_ADDR" \
           "zmq:tcp://127.0.0.2:6000,tcp://127.0.0.2:7000" \
           $DPORT "$MTU" "$OVH" "$loss" "$BURST" "$s" "$ORA" $SRV_ADDR 0 "$HD_RATE" >"$ILOG" 2>&1 &
    INJPID=$!
    sleep 2

    "$TRIG" -z 127.0.0.2 -a $TRIG_ADDR -n $CLI_ADDR -s $SRV_ADDR -d "$OUT" -f file.bin >/dev/null 2>&1

    # Wait for the SERVER to finish sending; the client needs its own 16 s idle timeout
    # on top of that before it reports, and on a paced link the queue drains for minutes
    # after the server is done.
    for i in $(seq 1 "$WINDOW"); do
        grep -q "Transfer done" "$SRVLOG" 2>/dev/null && break
        sleep 1
    done
    # The server finishing says nothing about DELIVERY on a paced link: the whole burst
    # sits queued in the bridge and drains at HD_RATE, so the client can lag the server by
    # the full transfer airtime. The delivered FILE's size is useless as a signal -- the
    # client preallocates it to full size with a dummy end write on the first packet -- so
    # watch the client's own received-bytes progress counter instead. Done when it reaches
    # the payload size (clean cell), when it stalls for a minute (lossy cell: the queue
    # has drained and only holes remain), or at twice the transfer airtime (backstop).
    if [ "$HD_RATE" -gt 0 ]; then
        drain_deadline=$(( PBYTES * 8 * 2 / HD_RATE + 120 ))
    else
        drain_deadline=90
    fi
    prev=-1; stall=0; waited=0
    while [ "$waited" -lt "$drain_deadline" ]; do
        got=$(grep -aoE "[0-9]+/$PBYTES" "$CLILOG" 2>/dev/null | tail -1 | cut -d/ -f1)
        if [ "${got:-0}" -ge "$PBYTES" ] 2>/dev/null; then break; fi
        sz=$(sweep_size "$CLILOG")
        if [ "$sz" = "$prev" ]; then stall=$((stall+5)); else stall=0; fi
        [ "$stall" -ge 60 ] && break
        prev=$sz; sleep 5; waited=$((waited+5))
    done
    sleep "$SETTLE"   # let the last write finalise before hashing

    sweep_stop_pid "$INJPID"

    # What the mechanism itself claimed, within the window. The status line is emitted only
    # when the receive loop returns, which under loss it does not, so NO_VERDICT is the
    # normal lossy outcome and is itself the RQ2 observation: no loud failure was raised.
    verdict=NO_VERDICT
    if grep -q "Received .* status: 0" "$CLILOG" 2>/dev/null; then
        verdict=REPORTED_OK
    elif grep -q "Received .* status: [^0]" "$CLILOG" 2>/dev/null; then
        verdict=REPORTED_ERR
    fi
    rxbytes=$(grep -oE 'Received [0-9]+ bytes' "$CLILOG" 2>/dev/null | grep -oE '[0-9]+' | tail -1)

    sweep_cleanup

    sweep_oracle_counts "$ORA"
    sweep_harness_health "$ILOG"
    got=$(sweep_sha "$OUT")
    sha=MISMATCH; [ "$got" = "$IN_SHA" ] && sha=MATCH
    gsz=$(sweep_size "$OUT")
    ts=$(sweep_ts)

    warn=""
    [ "$verdict" != "REPORTED_ERR" ] && [ "$sha" = MISMATCH ] && [ "$gsz" -gt 0 ] && \
        warn="  *** SILENT CORRUPTION ***"
    echo "$loss,$s,${inj:-0},${drp:-0},$verdict,${rxbytes:-0},$sha,$gsz,zmq,$HD_RATE,$harness,$IN_SHA,$ts" >> "$CSV"
    echo "[$L] verdict=$verdict sha=$sha size=$gsz inj=${inj:-0} drop=${drp:-0} harness=$harness$warn"
  done
done

echo
echo "=== $CSV ==="
column -t -s, "$CSV" 2>/dev/null || cat "$CSV"
echo
echo "--- full-size deliveries (size == payload) ---"
awk -F, -v p="$PBYTES" 'NR>1{n++; if($8==p) f++} END{print f+0"/"n+0}' "$CSV"
echo "--- loud failures (mechanism reported an error, expect 0) ---"
awk -F, 'NR>1 && $5=="REPORTED_ERR"{c++} END{print c+0}' "$CSV"
echo "--- silent corruption (no loud failure & sha MISMATCH & bytes delivered) ---"
awk -F, 'NR>1 && $5!="REPORTED_ERR" && $7=="MISMATCH" && $8>0{c++} END{print c+0}' "$CSV"
