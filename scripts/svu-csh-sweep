#!/usr/bin/env bash
#
# svu-csh-sweep - the SVU arm against the payload board, pushed by REAL csh.
#
# svu-board-sweep drives the standalone svu binary; this sweep exists because the
# flatsat campaign is csh-only: the push side here is csh's native `svu` command
# (APM libcsh_svu.so), the same instrument an operator would use on a pass, wired
# through the injector onto the real bus:
#
#   csh (`svu -p ...`, zmq 127.0.0.1 as 5425) -> broker -> ci_inject_bridge -> can0 -> svu_daemon on board
#                                                    (drops SVU data frames, dport 9 = oracle A)
#
# GRID: svu_daemon pulls at MTU 256 / block 4096 (svu_daemon.c:80) -> 248-byte span,
# 1058-fragment flight grid for the pinned 256 KiB payload -- the same grid and the
# same payload as the board satdeploy dataset, so the two csh board arms are matched.
# A cell whose observed grid is not $TOTAL is invalid, same rule as everywhere.
#
# BOARD SIDE (once per session): /home/root/svu_daemon -c can0 -a 5426  (aarch64
# build, deployed via scripts/deploy-file). 5426 is ALSO the Upload-Client's addr:
# toggle `set -n 5421 mng_util 0` before this sweep, never run both at once.
#
# The daemon self-verifies per block and reports VERIFIED/FAILED -- that verdict is
# the mechanism's claim (oracle B). External readback needs board access; record
# sha=UNVERIFIED unless BOARD_SSH is set (then scp-back + sha256, oracle C).
#
# Usage: svu-csh-sweep       (env: LOSSES, SEEDS, RATE_BPS, BOARD_ADDR, BOARD_SSH, TAG)
# Resumable: cells already recorded status=ok are skipped. Exit 2 = daemon down.
set -uo pipefail

REPO="${REPO:-/home/mseo/thesis/csp-linksim}"
CSH="${CSH:-/home/mseo/thesis/csh/builddir/csh}"
INJ="$REPO/build/tests/e2e/ci_inject_bridge"
OUT="${CSV:-$REPO/captures/svu_csh_sweep.csv}"
PAY="$REPO/captures/payload_256k.bin"

GS_ADDR=5425; BOARD_ADDR="${BOARD_ADDR:-5426}"; DPORT=9
MTU=256; OVH=8; TOTAL=1058            # fixed by svu_daemon.c:80; verified per cell
LOSSES="${LOSSES:-0 0.02 0.05 0.10 0.20 0.30}"
SEEDS="${SEEDS:-1 2 3}"
RATE_BPS="${RATE_BPS:-9600}"
TAG="${TAG:-c1_}"
BOARD_SSH="${BOARD_SSH:-}"

PACE_US=$(( RATE_BPS > 0 ? MTU * 8 * 1000000 / RATE_BPS : 0 ))
SER_S=$(( RATE_BPS > 0 ? TOTAL * PACE_US / 1000000 : 30 ))
PUSH_TO=$(( SER_S * 3 + 120 )); [ "$PUSH_TO" -lt 300 ] && PUSH_TO=300
INJ_TO=$(( PUSH_TO + 60 ))

[ -x "$INJ" ] || { echo "FAIL: missing $INJ"; exit 1; }
[ -x "$CSH" ] || { echo "FAIL: missing $CSH"; exit 1; }
[ -f "$PAY" ] || { echo "FAIL: missing $PAY"; exit 1; }
PAY_SHA=$(sha256sum "$PAY" | cut -d' ' -f1)
ss -ltn 2>/dev/null | grep -q ':6000' || { echo "FAIL: broker 6000 down"; exit 1; }

# short-path init files: csh silently truncates -i paths at ~100 chars
run_csh(){ local init="$1" to="$2"; timeout "$to" script -qec "$CSH -i $init" /dev/null </dev/null 2>&1; }

daemon_up(){
    # csh ping over can0 directly (the bench host is on the bus); the zmq segment
    # only reaches the board while a bridge is up, so probe outside the injector.
    local P; P=$(mktemp /tmp/svuc_ping_XXXX.csh)
    printf 'csp init\ncsp add can -c can0 -b 0 -d 16\nping %s\nsleep 300\nexit\n' "$BOARD_ADDR" > "$P"
    local out; out=$(run_csh "$P" 20); rm -f "$P"
    echo "$out" | grep -qa "Reply in"
}

echo "svu-csh-sweep: payload=$PAY sha256=${PAY_SHA:0:16}…"
echo "  grid=fixed mtu=$MTU total=$TOTAL rate_bps=$RATE_BPS pace_us=$PACE_US push_to=${PUSH_TO}s"
echo "  board=$BOARD_ADDR pusher=csh external_oracle=$([ -n "$BOARD_SSH" ] && echo scp || echo none)  csv=$OUT"

[ -f "$OUT" ] || echo "loss,seed,label,injected,dropped,rev_frames,result,sha,obs_grid,transport,harness,rate_bps,payload_sha256,status,ts" > "$OUT"

daemon_up || { echo "FAIL: svu_daemon at $BOARD_ADDR not answering on can0 -- start it on the board first (see header)"; exit 2; }

trap 'pkill -f ci_inject_bridge 2>/dev/null; exit 130' INT TERM

for loss in $LOSSES; do for seed in $SEEDS; do
  label="svuc_${TAG}L${loss}_s${seed}"
  if awk -F, -v l="$loss" -v s="$seed" 'NR>1&&$1==l&&$2==s&&$14=="ok"{f=1}END{exit !f}' "$OUT"; then
      echo "-- $label done, skip"; continue; fi
  if pgrep -x ci_inject_bridge >/dev/null; then echo "FAIL: stray bridge, clean up first"; exit 1; fi

  DEST="/home/root/svu_${TAG}${label}.bin"
  ORA="$REPO/captures/${label}_oracleA.csv"; ILOG="/tmp/${label}_inj.log"; rm -f "$ORA"

  timeout "$INJ_TO" "$INJ" "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,$BOARD_ADDR" \
      can:can0 $DPORT "$MTU" "$OVH" "$loss" 4 "$seed" "$ORA" $GS_ADDR "$PACE_US" >"$ILOG" 2>&1 &
  INJPID=$!; sleep 3

  UP=$(mktemp /tmp/svuc_up_XXXX.csh)
  printf 'csp init\ncsp add zmq -d %s 127.0.0.1\napm load\nsvu -p %s %s:%s\nsleep 2000\nexit\n' \
      "$GS_ADDR" "$PAY" "$BOARD_ADDR" "$DEST" > "$UP"
  out=$(run_csh "$UP" "$PUSH_TO"); rm -f "$UP"
  kill -INT "$INJPID" 2>/dev/null; sleep 0.3; kill "$INJPID" 2>/dev/null; wait "$INJPID" 2>/dev/null || true

  result=INCOMPLETE
  echo "$out" | grep -qaE "VERIFIED|OK"  && result=DELIVERED
  echo "$out" | grep -qa  "FAIL"         && result=FAILED
  if [ "$result" = INCOMPLETE ] && ! daemon_up; then
      echo ">>> DAEMON DOWN at $label -- restart svu_daemon on the board, re-run (resumable) <<<"; exit 2; fi

  inj=$(awk -F, '!/^#/{c++}END{print c+0}' "$ORA")
  drp=$(awk -F, '!/^#/&&$8==1{c++}END{print c+0}' "$ORA")
  rev=$(grep -oE 'reverse_frames=[0-9]+' "$ILOG" | grep -oE '[0-9]+' | tail -1); rev="${rev:-0}"
  obs=$(awk -F, '!/^#/{if($6+0>m)m=$6+0;s=1}END{print s?m+1:0}' "$ORA")
  ne=$(grep -oE 'nexthop_errors=[0-9]+' "$ILOG" | grep -oE '[0-9]+' | tail -1); ne="${ne:-0}"
  harness="clean"; [ "$ne" != 0 ] && harness="INVALID_nexthop_err=$ne"
  [ "$obs" != "$TOTAL" ] && [ "$inj" != 0 ] && harness="frag_mismatch(obs=$obs/exp=$TOTAL);$harness"

  sha=UNVERIFIED
  if [ -n "$BOARD_SSH" ]; then
      if scp -q "$BOARD_SSH:$DEST" "/tmp/${label}_back.bin" 2>/dev/null; then
          got=$(sha256sum "/tmp/${label}_back.bin" | cut -d' ' -f1)
          sha=MISMATCH; [ "$got" = "$PAY_SHA" ] && sha=MATCH
      else
          sha=READBACK_FAILED
      fi
  fi

  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  warn=""; [ "$result" = DELIVERED ] && [ "$sha" = MISMATCH ] && warn="  *** SILENT CORRUPTION ***"
  echo "$loss,$seed,$label,$inj,$drp,$rev,$result,$sha,$obs,can,$harness,$RATE_BPS,$PAY_SHA,ok,$ts" >> "$OUT"
  echo "[$label] result=$result sha=$sha inj=$inj drop=$drp rev=$rev grid=$obs harness=$harness$warn"
  sleep 3
done; done

echo; echo "== $OUT =="
column -t -s, "$OUT" 2>/dev/null || cat "$OUT"
echo "-- silent corruption (DELIVERED & MISMATCH, expect 0) --"
awk -F, 'NR>1&&$7=="DELIVERED"&&$8=="MISMATCH"{c++}END{print c+0}' "$OUT"
