#!/usr/bin/env bash
#
# rdp-settle-check - discriminate a REAL silent corruption on the RDP reference path from the
# verify-timing harness artifact that Chapter 5 already reports as refuted.
#
# THE QUESTION
# rdp-host-sweep found cells where vmem_upload reported success (returned the full byte count)
# while the region read back with a different sha256. There are two explanations:
#
#   (H-artifact) the receiver had the bytes but had not finalized the write when the read-back
#                fired. Chapter 5's fourth threat documents exactly this at 0% loss.
#   (H-real)     vmem_upload_progress counts bytes it QUEUED, not bytes acknowledged:
#                  while ((count < length) && csp_conn_is_active(conn)) { ...; count += len;
#                  csp_send(conn, packet); }
#                  csp_close(conn); return count;
#                so a connection that stays nominally active while its tail goes undelivered
#                returns length == success over an incomplete region.
#
# THE TEST
# Re-run one cell with a long settle before the read-back. H-artifact predicts the sha flips to
# MATCH once the receiver has had time. H-real predicts it stays MISMATCH no matter how long we
# wait, because the bytes were never sent.
#
# The byte-level profile discriminates further: H-real predicts the damage is a CONTIGUOUS TAIL
# (the packets in flight when the connection closed), while scattered damage across the whole
# region would point elsewhere.
#
# Usage: rdp-settle-check <loss> <seed> [settle_s]      e.g.  rdp-settle-check 0.20 3 60
set -uo pipefail
LOSS="${1:?loss}"; SEED="${2:?seed}"; SETTLE="${3:-60}"

CLI_ADDR=26; NODE=5431; DPORT=14
MTU="${MTU:-200}"; OVH="${OVH:-8}"; BURST="${BURST:-4}"
PBYTES="${PBYTES:-262144}"; PAYLOAD_SEED="${PAYLOAD_SEED:-20260729}"
VADDR="${VADDR:-0x10000000}"; UP_TO="${UP_TO:-120000}"

. "$(dirname "$0")/lib/host-sweep-lib.sh"
NODEBIN="$BUILD/tests/e2e/vmem_node"; PUSH="$BUILD/tests/e2e/rdp_push"
SWEEP_PROCS="vmem_node"

sweep_require "$PROXY" "$INJ" "$NODEBIN" "$PUSH"
sweep_payload "$PBYTES" "$PAYLOAD_SEED"

L="rdpsettle_L${LOSS}_s${SEED}_w${SETTLE}"
GOT="$CAP/${L}_got.bin"          # into captures/ so it survives the container
ORA="$CAP/${L}_oracleA.csv"
rm -f "$GOT" "$ORA"

sweep_trap
start_bridge() {
    "$INJ" "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,$NODE" \
           "zmq:tcp://127.0.0.2:6000,tcp://127.0.0.2:7000" \
           $DPORT "$MTU" "$OVH" "$1" "$BURST" "$SEED" "$2" $CLI_ADDR 0 0 >"$3" 2>&1 &
    echo $!
}
sweep_cleanup
sweep_start_brokers "$L"
"$NODEBIN" -z 127.0.0.2 -a $NODE >/tmp/${L}_node.log 2>&1 &
sweep_wait_log /tmp/${L}_node.log 'vmem_node up' 

echo "[$L] pre-filling region with zeros over a clean path"
BP=$(start_bridge 0 /dev/null /tmp/${L}_fill.log); sleep 2
timeout 300 "$PUSH" -m fill -z 127.0.0.1 -a $CLI_ADDR -n $NODE -A "$VADDR" -l "$PBYTES" -t "$UP_TO" >/dev/null 2>&1
fill_rc=$?
sweep_stop_pid "$BP"
[ $fill_rc -eq 0 ] || { echo "FAIL: pre-fill did not complete - cell invalid"; sweep_cleanup; exit 4; }

echo "[$L] measured upload at loss=$LOSS seed=$SEED"
BP=$(start_bridge "$LOSS" "$ORA" /tmp/${L}_inj.log); sleep 2
up_out=$(timeout 900 "$PUSH" -m upload -z 127.0.0.1 -a $CLI_ADDR -n $NODE -f "$IN" -A "$VADDR" -t "$UP_TO" 2>&1)
up_rc=$?
sweep_stop_pid "$BP"
claimed=FAILED; [ $up_rc -eq 0 ] && claimed=DELIVERED
echo "[$L] upload says: $(echo "$up_out" | grep RESULT || echo "$up_out" | tail -1)"

echo "[$L] settling ${SETTLE}s before read-back (this is the variable under test)"
sleep "$SETTLE"

BP=$(start_bridge 0 /dev/null /tmp/${L}_dl.log); sleep 2
timeout 300 "$PUSH" -m download -z 127.0.0.1 -a $CLI_ADDR -n $NODE -o "$GOT" -A "$VADDR" -l "$PBYTES" -t "$UP_TO" >/tmp/${L}_dlout.log 2>&1
dl_rc=$?
sweep_stop_pid "$BP"; sweep_cleanup
[ $dl_rc -eq 0 ] || { echo "FAIL: clean read-back did not complete - cannot judge this cell"; exit 5; }

got=$(sweep_sha "$GOT")
sha=MISMATCH; [ "$got" = "$IN_SHA" ] && sha=MATCH
inj=$(awk -F, '!/^#/{c++} END{print c+0}' "$ORA" 2>/dev/null)
drp=$(awk -F, '!/^#/ && $8==1{c++} END{print c+0}' "$ORA" 2>/dev/null)

echo
echo "=== $L ==="
echo "claimed=$claimed  sha=$sha  settle=${SETTLE}s  injected=${inj:-0} dropped=${drp:-0}"

# Byte-level profile: contiguous tail damage supports H-real, scattered damage does not.
python3 - "$IN" "$GOT" <<'PY'
import sys
a = open(sys.argv[1], 'rb').read()
b = open(sys.argv[2], 'rb').read()
if len(a) != len(b):
    print(f"size differs: src={len(a)} got={len(b)}"); sys.exit()
diff = [i for i in range(len(a)) if a[i] != b[i]]
if not diff:
    print("identical - no corruption"); sys.exit()
first, last = diff[0], diff[-1]
zeros = sum(1 for i in diff if b[i] == 0)
contiguous = (last - first + 1) == len(diff)
print(f"differing bytes: {len(diff)} of {len(a)}  ({100*len(diff)/len(a):.1f}%)")
print(f"first differing offset: {first}   last: {last}")
print(f"damaged span is contiguous: {contiguous}")
print(f"tail-only (damage runs to the final byte): {last == len(a)-1}")
print(f"of the damaged bytes, {zeros} are still the zero pre-fill ({100*zeros/len(diff):.1f}%)")
print(f"intact prefix: {first} bytes ({100*first/len(a):.1f}% of the artifact)")
PY
