#!/usr/bin/env bash
#
# rdp-board-sweep - RDP+CRC32 integrity sweep against the BOARD vmem_node, with
# csp_loss (the csh APM) as the channel instead of ci_inject_bridge.
#
# WHY NOT THE BRIDGE: RDP's ack-driven connection proved nondeterministic through
# the zmq->bridge->can0 path to the board (2026-08-07: five outcome shapes at loss
# zero, 20-45% retransmit inflation), while the direct can0 path is byte-perfect.
# csp_loss drops packets in the sender's TX path: seeded (-S = replayable channel),
# marginal rate (-L), and burst-shaped (-B, Gilbert-Elliott) -- the same channel
# model as the calibrated replay, on the path that is proven sound.
#
# EVIDENCE PER CELL (all in one csh session, mirroring the validated rdp-baseline flow):
#   channel record : csp_loss status at stop (its own drop count, seeded+replayable)
#   mechanism claim: did `upload` print "Uploaded <size> bytes"
#   external check : clean crc32 AND download-back sha256 vs the original
# Silent corruption == claimed DELIVERED and sha MISMATCH (with harness drains in
# place and no bridge, that is a mechanism result, not an artifact).
#
# Usage: rdp-board-sweep [mode] [losses] [nseeds]
#   mode = stock | tuned | both   (default stock; tuned = -w 5 -c 120000 -p 1000 -k 250)
#   env: BURST="7.8" adds -B (GE bursts at the mined real-pass shape); SEEDS override.
# Resumable: cells with status=ok are skipped.
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSH="${CSH:-/home/mseo/thesis/csh/builddir/csh}"
NODE=5431; REGION=0x10000000
# The artifact is a parameter, not a constant: the August 2026 experiments upload a real
# DISCO-2 flight module, and SIZE must follow whatever PAY points at or the region
# read-back compares the wrong number of bytes.
PAY="${PAY:-$REPO/captures/payload_libjpegxl.bin}"
[ -f "$PAY" ] || { echo "FAIL: payload $PAY not found (set PAY=)"; exit 1; }
SIZE="${SIZE:-$(stat -c%s "$PAY")}"
RATE_BPS="${RATE_BPS:-4800}"
ZER="/tmp/zeros_${SIZE}.bin"
CSV="${CSV:-$REPO/captures/rdp_experiment_2026-08.csv}"
MODE="${1:-stock}"; LOSSES="${2:-0 0.10 0.20 0.30}"; NSEEDS="${3:-3}"
BURST="${BURST:-}"
# Both timeouts must scale with artifact and rate. A clean paced transfer of SIZE bytes
# needs SIZE*8/RATE seconds on the wire (112 s for 67 KB at 4800), so a fixed 120 s upload
# timeout expires during the transfer itself once pacing is real, and RDP retransmitting
# under loss needs several multiples of that. A truncated session yields no claim, no drop
# count and no read-back, which reads as a result but is a harness artifact.
SER_S=$(( SIZE * 8 / RATE_BPS ))
UP_TO="${UP_TO:-$(( SER_S * 6 * 1000 ))}"          # csh upload timeout, ms
SESS_TO="${SESS_TO:-$(( SER_S * 8 + 180 ))}"       # whole csh session, s
# Pacing must match the deployed-uploader experiment or the two are not comparable.

ORIG_SHA=$(sha256sum "$PAY" | cut -d' ' -f1)
[ -s "$ZER" ] && [ "$(stat -c%s "$ZER")" = "$SIZE" ] || head -c "$SIZE" /dev/zero > "$ZER"
[ -x "$CSH" ] || { echo "FAIL: no csh at $CSH"; exit 1; }
[ -f "$CSV" ] || echo "mode,loss,seed,burst,claimed,crc,sha,loss_drops,verdict,ts,rate_bps,artifact,artifact_bytes" > "$CSV"

strip_ansi(){ sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r'; }

modes="$MODE"; [ "$MODE" = both ] && modes="stock tuned"
for mode in $modes; do
  CONTROL_OK=unset; CONTROL_VD=ABSENT
  opt=""; [ "$mode" = tuned ] && opt="-w 5 -c 120000 -p 1000 -k 250"
  for loss in $LOSSES; do
    for s in $(seq 1 "$NSEEDS"); do
      # The artifact is part of the run identity. Without it, two artifacts at the same
      # (mode, loss, burst, seed) share one /tmp log and the second overwrites the first:
      # the libcolor runs destroyed the libjpegxl session log backing a committed row.
      label="rdpcl_${mode}_$(basename "$PAY" .bin)_L${loss}_b${BURST:-0}_s${s}"
      if awk -F, -v m="$mode" -v l="$loss" -v sd="$s" -v b="${BURST:-0}" \
           'NR>1&&$1==m&&$2==l&&$3==sd&&$4==b&&$9=="OK"{f=1}END{exit !f}' "$CSV"; then
        echo "-- $label done, skip"; continue; fi

      GOT="/tmp/${label}_got.bin"; rm -f "$GOT"
      INIT=$(mktemp /tmp/rdpcl_XXXX.csh)
      {
        echo "csp init"
        echo "csp add can -c can0 -b 0 -d 20"
        # Both loads are required. Bare `apm load` takes the installed APM path only, which
        # does NOT contain csp_loss: it is built in-project. Without the second load
        # `csp_loss start` is an unknown command, csh carries on, and the transfer runs
        # clean at line rate with no drops and no pacing while still reporting DELIVERED.
        # ORDER IS LOAD-BEARING. `apm load` takes ~/.local first and the second load then
        # SKIPS csp_loss as "already loaded". The ~/.local copy predates the -R pacing
        # patch, so `csp_loss start -R ...` is rejected outright and the link stays clean:
        # no drops, no pacing, and every run reports DELIVERED/MATCH. Build path first.
        echo "apm load -p $REPO/build/apm"
        echo "apm load"
        # -- clean pre-fill + gate (region must NOT equal payload before the run)
        echo "upload -n $NODE -v 2 -t $UP_TO $ZER $REGION"
        echo "sleep 3000"
        echo "crc32 -n $NODE -v 2 -f $PAY $REGION"
        echo "sleep 500"
        # -- the lossy transfer (channel on, seeded)
        [ -n "$opt" ] && echo "rdp opt $opt"
        # The control is armed too, at -L 0. Skipping csp_loss at zero loss would leave the
        # control running at can0 line rate while every lossy run is paced, so the control
        # would not be a control of the same channel.
        if [ "$loss" != 0 ] || [ -n "$BURST" ]; then
          echo "csp_loss start -L $loss ${BURST:+-B $BURST} -S $s ${RATE_BPS:+-R $RATE_BPS}"
        else
          echo "csp_loss start -L 0.0 ${RATE_BPS:+-R $RATE_BPS}"
        fi
        echo "upload -n $NODE -v 2 -t $UP_TO $PAY $REGION"
        echo "sleep 6000"
        echo "csp_loss status"; echo "csp_loss stop"
        # -- wait out RDP conn_timeout, then clean verify on the clean link
        echo "sleep 12000"
        echo "crc32 -n $NODE -v 2 -f $PAY $REGION"
        echo "sleep 500"
        echo "download -n $NODE -v 2 -t $UP_TO $REGION $SIZE $GOT"
        echo "sleep 1000"
        echo "exit"
      } > "$INIT"
      out=$(timeout "$SESS_TO" script -qec "$CSH -i $INIT" /dev/null </dev/null 2>&1 | strip_ansi)
      rm -f "$INIT"
      echo "$out" > "/tmp/${label}_session.log"
      # Retain the primary source. DTP and satdeploy archive per-run logs; RDP did not,
      # so its evidence lived only in /tmp and was collidable.
      mkdir -p "$REPO/captures/evidence/rdp_2026-08"
      cp "/tmp/${label}_session.log" "$REPO/captures/evidence/rdp_2026-08/${label}.log" 2>/dev/null || true

      # gate: first crc32 must be Failure (zeros != payload); its Success = stale region
      gate=$(echo "$out" | grep -aE "Success|Failure" | head -1)
      case "$gate" in *Failure*) ;; *) echo "[$label] INVALID: pre-fill gate ($gate)"; continue;; esac

      # The session runs TWO uploads: the clean pre-fill first, then the lossy
      # payload. The mechanism's claim is the SECOND upload's outcome -- grepping
      # the whole log for "Uploaded" matches the pre-fill's success line and
      # misclassifies a loud abort as DELIVERED (the 2026-08-10 parser bug: all
      # 27 committed lossy cells printed "Upload didn't complete" and were still
      # recorded as silent corruption).
      up2=$(echo "$out" | grep -aE "Uploaded $SIZE bytes|didn't complete" | sed -n '2p')
      case "$up2" in
        *"Uploaded $SIZE bytes"*) claimed=DELIVERED;;
        *"didn't complete"*)      claimed=FAILED;;
        *)                        claimed=NO_VERDICT;;
      esac
      crc=$(echo "$out" | grep -aE "Success|Failure" | sed -n '2p')
      case "$crc" in *Success*) crc=SUCCESS;; *) crc=MISMATCH;; esac
      drops=$(echo "$out" | grep -a "csp_loss" | grep -oE "[0-9]+ *dropped|dropped[ :=]*[0-9]+" | grep -oE "[0-9]+" | head -1); drops="${drops:-0}"
      got_sha=$(sha256sum "$GOT" 2>/dev/null | cut -d' ' -f1)
      sha=MISMATCH; [ "$got_sha" = "$ORIG_SHA" ] && sha=MATCH
      [ "$sha" = MATCH ] && rm -f "$GOT" || mv -f "$GOT" "/tmp/${label}_got_keep.bin" 2>/dev/null

      # Injector guard FIRST. The nine runs in rdp_experiment_2026-08_VOID-no-injector.csv
      # all read loss=0.30, drops=0, OK, because a stale csp_loss without -R was rejected
      # and nothing checked. A verdict ladder keyed only on claimed/sha cannot see this.
      if ! printf '%s' "$out" | grep -qa "pacing egress at ${RATE_BPS} bit/s"; then
        vd=VOID_NOT_PACED
      elif [ "$loss" != 0 ] && ! printf '%s' "$out" | grep -qaE "csp_loss: .*loss on"; then
        vd=VOID_NO_LOSS_ARMED
      elif [ "$loss" != 0 ] && [ "${drops:-0}" -eq 0 ] 2>/dev/null; then
        vd=VOID_ZERO_DROPS_AT_LOSS
      else
      # Fail closed. Enumerate what is understood; everything else is void, not OK.
      case "$claimed/$sha" in
        DELIVERED/MATCH)    vd=OK ;;
        DELIVERED/MISMATCH) vd=SILENT_CORRUPTION ;;
        FAILED/MISMATCH)    vd=LOUD_ABORT ;;
        FAILED/MATCH)       vd=ABORT_BUT_INTACT ;;
        NO_VERDICT/*)       vd=VOID_NO_CLAIM ;;
        *)                  vd=VOID_UNCLASSIFIED ;;
      esac
      # A control that did not pass voids every lossy run in the same experiment. The
      # libcolor set shipped a LOUD_ABORT control beside an OK 0.30 row because this
      # was prose in the plan and nothing in the harness.
      fi
      # F3: CONTROL_VD is per (mode, artifact). It used to live outside the mode loop, so a
      # passing stock control gated every tuned row and only the last control seed counted.
      if [ "$loss" = 0 ]; then
        [ "$vd" = OK ] && CONTROL_OK=1 || CONTROL_OK=0
        CONTROL_VD="$vd"
      elif [ "${CONTROL_OK:-unset}" != "1" ]; then
        vd="VOID_CONTROL_${CONTROL_VD:-ABSENT}"
      fi
      ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      echo "$mode,$loss,$s,${BURST:-0},$claimed,$crc,$sha,$drops,$vd,$ts,$RATE_BPS,$(basename "$PAY"),$SIZE" >> "$CSV"
      echo "[$label] claimed=$claimed crc=$crc sha=$sha drops=$drops -> $vd"
      sleep 3
    done
  done
done
echo; echo "== $CSV =="; column -t -s, "$CSV" 2>/dev/null | tail -20