#!/usr/bin/env bash
#
# svu-zmq-sweep - the SVU host arm over a pure-ZMQ path. No CAN bus, no payload board.
#
# WHY THIS EXISTS, AND HOW IT DIFFERS FROM svu-point
# svu-point wires the client onto can0, so it needs the flatsat. This runs the identical
# mechanism with both ends on ZMQ, which makes the host arm reproducible on any laptop:
#
#   svu_server -z 127.0.0.1 -> broker A -> ci_inject_bridge -> broker B -> svu_client -z 127.0.0.2
#                                            (drops SVU data frames, dport 9 = oracle A)
#
# Two brokers are required because svu_server/-client hardcode broker ports 6000/7000, so the
# two CSP segments are separated by loopback ALIAS (127.0.0.1 vs 127.0.0.2) rather than port.
# The injector bridges them; zmq-to-zmq is a first-class mode of ci_inject_bridge.
#
# TRANSPORT CAVEAT (read before citing these numbers)
# Frame counts here are CSP packets on ZMQ. On the can0 path each CSP packet fragments into
# many CAN frames, so forward/reverse FRAME counts are NOT comparable between the two
# topologies. Delivery verdicts (verified, sha, rounds) ARE comparable: they are properties of
# the mechanism, not the link. The CSV records transport= so a reader cannot mix them up.
#
# Integrity is rate-independent, so this runs unpaced by default (as svu-point does). Set
# HD_RATE to charge half-duplex airtime; expect cells to take minutes, not seconds.
#
# Per cell: pull the payload through the injector; the client self-verifies against its
# per-block manifest. Then an EXTERNAL sha256 confirms the self-verification did not lie.
#   SILENT CORRUPTION == claimed VERIFIED & sha MISMATCH. Expected: never.
#
# Usage: svu-zmq-sweep ["0 0.02 0.05 0.10 0.20 0.30"] [nseeds]
# Resumable: an already-recorded (loss, seed) is skipped.
set -uo pipefail

LOSSES="${LOSSES:-${1:-0 0.02 0.05 0.10 0.20 0.30}}"
NSEEDS="${NSEEDS:-${2:-3}}"
SRV_ADDR=25; CLI_ADDR=26; DPORT=9
MTU="${MTU:-200}"; OVH="${OVH:-8}"; BLOCK="${BLOCK:-4096}"; BURST="${BURST:-4}"
HD_RATE="${HD_RATE:-0}"
PBYTES="${PBYTES:-262144}"          # 256 KiB, the size the other arms use
PAYLOAD_SEED="${PAYLOAD_SEED:-20260729}"

. "$(dirname "$0")/lib/zmq-sweep-lib.sh"
CSV="${CSV:-$CAP/svu_sweep.csv}"
SRV="$BUILD/svu/svu_server"
CLI="$BUILD/svu/svu_client"
SWEEP_PROCS="svu_server"

sweep_require "$PROXY" "$INJ" "$SRV" "$CLI"

# Deterministic payload. The pinned captures/payload_256k.bin is not in the repo (gitignored,
# lives on the bench host), so the exact bytes of the other arms cannot be reproduced here.
# A seeded PRNG gives a payload that IS reproducible by anyone who runs this script, and its
# digest is recorded alongside the results.
sweep_payload "$PBYTES" "$PAYLOAD_SEED"
echo "svu-zmq-sweep: payload=${PBYTES}B sha256=${IN_SHA}"
echo "  losses=[$LOSSES] nseeds=$NSEEDS block=$BLOCK mtu=$MTU burst=$BURST hd_rate=$HD_RATE"
echo "  csv=$CSV"

[ -f "$CSV" ] || echo "loss,seed,injected,dropped,claimed,rounds,rev_frames,sha,size,transport,harness,payload_sha256,ts,mtu" > "$CSV"

sweep_trap

for loss in $LOSSES; do
  for s in $(seq 1 "$NSEEDS"); do
    if sweep_cell_recorded "$CSV" "$loss" "$s" "$MTU"; then
        echo "[L${loss}_s${s}] already recorded, skipping"
        continue
    fi
    L="svuz_L${loss}_s${s}"
    ORA="$CAP/${L}_oracleA.csv"; OUT="/tmp/${L}_out.bin"; ILOG="/tmp/${L}_inj.log"
    rm -f "$OUT" "$ORA"
    sweep_cleanup
    sweep_start_brokers "$L"

    "$SRV" -z 127.0.0.1 -a $SRV_ADDR -f "$IN" -b "$BLOCK" >/tmp/${L}_srv.log 2>&1 &
    sweep_wait_log /tmp/${L}_srv.log serving

    "$INJ" "zmq:tcp://127.0.0.1:6000,tcp://127.0.0.1:7000,$CLI_ADDR" \
           "zmq:tcp://127.0.0.2:6000,tcp://127.0.0.2:7000" \
           $DPORT "$MTU" "$OVH" "$loss" "$BURST" "$s" "$ORA" $SRV_ADDR 0 "$HD_RATE" >"$ILOG" 2>&1 &
    INJPID=$!
    sleep 2

    out=$(timeout 1800 "$CLI" -z 127.0.0.2 -a $CLI_ADDR -C $SRV_ADDR -o "$OUT" -b "$BLOCK" -m "$MTU" 2>&1)
    sweep_stop_pid "$INJPID"
    sweep_cleanup

    claimed=INCOMPLETE; rounds='?'
    if echo "$out" | grep -qE "VERIFIED $PBYTES bytes"; then
        claimed=VERIFIED
        rounds=$(echo "$out" | grep -oE 'in [0-9]+ round' | grep -oE '[0-9]+' | head -1)
    fi
    sweep_oracle_counts "$ORA"
    sweep_harness_health "$ILOG"
    sweep_grid_guard "$ORA" "$MTU" "$OVH" "$PBYTES"
    sweep_rev_frames "$ILOG"
    got=$(sweep_sha "$OUT")
    sha=MISMATCH; [ "$got" = "$IN_SHA" ] && sha=MATCH
    gsz=$(sweep_size "$OUT")
    ts=$(sweep_ts)

    warn=""
    [ "$claimed" = VERIFIED ] && [ "$sha" = MISMATCH ] && warn="  *** SILENT CORRUPTION ***"
    echo "$loss,$s,${inj:-0},${drp:-0},$claimed,${rounds:-?},${rev:-0},$sha,$gsz,zmq,$harness,$IN_SHA,$ts,$MTU" >> "$CSV"
    echo "[$L] claimed=$claimed rounds=${rounds:-?} sha=$sha inj=${inj:-0} drop=${drp:-0} rev=${rev:-0} harness=$harness$warn"
  done
done

echo
echo "=== $CSV ==="
column -t -s, "$CSV" 2>/dev/null || cat "$CSV"
echo
echo "--- completion (VERIFIED per cell) ---"
awk -F, 'NR>1{n++; if($5=="VERIFIED") v++} END{print v+0"/"n+0" VERIFIED"}' "$CSV"
echo "--- silent corruption (VERIFIED & sha MISMATCH, expect 0) ---"
awk -F, 'NR>1 && $5=="VERIFIED" && $8=="MISMATCH"{c++} END{print c+0}' "$CSV"
