#!/usr/bin/env bash
#
# bench - run the Linux front-ends from any host (macOS included) in a container.
#
# The front-ends need libzmq + SocketCAN headers, so they do not build on macOS. This wraps
# docker so the same commands work everywhere. Build artifacts go to a named volume, not the
# source tree, so the host's native lib/ build directory is untouched.
#
#   scripts/bench build              configure + compile everything
#   scripts/bench test               run the meson test suite
#   scripts/bench <script> [args]    run scripts/<script> inside the container
#   scripts/bench shell              interactive shell
#
# The repo is mounted read-WRITE so sweeps can append to captures/.
set -uo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE=csp-bench
VOLUME=csp-bench-build

command -v docker >/dev/null 2>&1 || { echo "FAIL: docker not found"; exit 1; }
docker info >/dev/null 2>&1 || { echo "FAIL: docker is installed but not running (start Docker Desktop)"; exit 1; }

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "[bench] building $IMAGE ..."
    docker build -q -t "$IMAGE" -f "$REPO/docker/Dockerfile.bench" "$REPO/docker" || exit 1
fi

# Forward the knobs the sweep drivers read, so `LOSSES=... scripts/bench svu-zmq-sweep` works
# the same way it would on the bench host. Only forwards vars that are actually set.
ENVARGS=()
for v in LOSSES NSEEDS CSV PBYTES PAYLOAD_SEED BLOCK MTU OVH BURST HD_RATE N RATE SEED \
         SETTLE WINDOW RUN_TAG MAX_PASSES PUSH_TO; do
    [ -n "${!v-}" ] && ENVARGS+=(-e "$v=${!v}")
done

# The deployed-uploader arm (scripts/dtp-zmq-sweep) builds DISCO's upload_gs-server and
# upload_sat-client from source. That tree is mission code and is not vendored here, so it
# is mounted only when it exists. Override the location with DISCO_SRC on the host.
DISCO_HOST="${DISCO_SRC:-$HOME/thesis/disco/src}"
DISCOARGS=()
if [ -d "$DISCO_HOST/upload_gs-server" ]; then
    DISCOARGS+=(-v "$DISCO_HOST":/disco -e DISCO_SRC=/disco)
fi
# satDeploy is the contributed tool's own repo (agent + csh APM). Mounted on the same
# terms as the DISCO tree so scripts/flatsat-build can stand up the whole mission stack
# in the container; absent, only the arms that do not need it are runnable.
SAT_HOST="${SAT_SRC:-$HOME/thesis/satDeploy}"
if [ -d "$SAT_HOST/satdeploy-agent" ]; then
    DISCOARGS+=(-v "$SAT_HOST":/satdeploy -e SAT_SRC=/satdeploy)
fi
# Persist the mission-stack build across container runs, as /build already is.
DISCOARGS+=(-v csp-flatsat-build:/tmp/flatsat -e FLATSAT_BUILD=/tmp/flatsat)

# ${arr[@]+"${arr[@]}"} so an EMPTY forward-list does not trip `set -u` (bash treats an
# unset-length array expansion as an unbound variable).
run() { docker run --rm -it ${ENVARGS[@]+"${ENVARGS[@]}"} ${DISCOARGS[@]+"${DISCOARGS[@]}"} \
            -v "$REPO":/src -v "$VOLUME":/build -w /src "$IMAGE" "$@"; }
run_quiet() { docker run --rm ${ENVARGS[@]+"${ENVARGS[@]}"} ${DISCOARGS[@]+"${DISCOARGS[@]}"} \
            -v "$REPO":/src -v "$VOLUME":/build -w /src "$IMAGE" "$@"; }

cmd="${1:-build}"; shift || true
case "$cmd" in
  build)
    run_quiet bash -c 'meson setup /build /src -Dfrontends=true >/dev/null 2>&1 || \
                       meson setup --reconfigure /build /src -Dfrontends=true >/dev/null 2>&1
                       ninja -C /build'
    ;;
  test)
    run_quiet bash -c 'ninja -C /build >/dev/null 2>&1; meson test -C /build --print-errorlogs "$@"' _ "$@"
    ;;
  shell)
    run bash
    ;;
  lab)
    # tmux needs a real TTY, so the lab goes through the interactive wrapper --
    # but only when we actually have one (`lab --check` may run from a script).
    if [ -t 0 ]; then
        run bash -c 'ninja -C /build >/dev/null 2>&1; exec /src/scripts/lab "$@"' _ "$@"
    else
        run_quiet bash -c 'ninja -C /build >/dev/null 2>&1; exec /src/scripts/lab "$@"' _ "$@"
    fi
    ;;
  *)
    [ -x "$REPO/scripts/$cmd" ] || { echo "FAIL: no scripts/$cmd"; exit 1; }
    run_quiet bash -c 'ninja -C /build >/dev/null 2>&1; exec "/src/scripts/$0" "$@"' "$cmd" "$@"
    ;;
esac
