#!/usr/bin/env bash
#
# rdp-prove-silent - one decisive cell proving RDP silent corruption is the
# upload's failure, NOT pre-existing garbage on the vmem node.
#
# Method (sentinel control):
#   1. pre-fill the region with a distinctive 0xAA sentinel over a CLEAN link
#   2. download it back and PROVE the region is exactly 0xAA before we start
#      (this rules out prior garbage AND proves the clean link delivers in full)
#   3. upload the real payload through a seeded csp_loss channel
#   4. download back over the clean link, sha256 vs the source
#   5. locate the first wrong byte and PROVE the wrong tail is still 0xAA
#      -- i.e. bytes this upload never delivered, not garbage, not stale payload
#
# Runs csh over can0 to the board (same path as the committed sweep). No serial
# console needed. Usage: rdp-prove-silent [loss] [seed]   (default 0.30 1)
set -uo pipefail
REPO=/home/mseo/thesis/csp-linksim
CSH="${CSH:-/home/mseo/thesis/csh/builddir/csh}"
NODE=5431; REGION=0x10000000; SIZE=262144
PAY="$REPO/captures/payload_256k.bin"
LOSS="${1:-0.30}"; SEED="${2:-1}"
SENT=/tmp/sentinel_AA.bin
PRECHK=/tmp/rps_prefill.bin
GOT=/tmp/rps_delivered.bin
LOG=/tmp/rps_session.log

[ -x "$CSH" ] || { echo "FAIL: no csh at $CSH"; exit 1; }
[ -f "$PAY" ] || { echo "FAIL: no payload at $PAY"; exit 1; }

# 0xAA sentinel, exactly SIZE bytes
python3 -c "open('$SENT','wb').write(b'\xAA'*$SIZE)"
ORIG_SHA=$(sha256sum "$PAY" | cut -d' ' -f1)
rm -f "$PRECHK" "$GOT"

INIT=$(mktemp /tmp/rps_XXXX.csh)
{
  echo "csp init"
  echo "csp add can -c can0 -b 0 -d 20"
  echo "apm load"
  # 1. pre-fill sentinel over the clean link
  echo "upload -n $NODE -v 2 -t 10000 $SENT $REGION"
  echo "sleep 3000"
  # 2. read the region back (clean) so we can prove it is exactly the sentinel
  echo "download -n $NODE -v 2 -t 10000 $REGION $SIZE $PRECHK"
  echo "sleep 1000"
  # 3. the lossy upload of the real payload
  echo "csp_loss start -L $LOSS -S $SEED"
  echo "upload -n $NODE -v 2 -t 120000 $PAY $REGION"
  echo "sleep 6000"
  echo "csp_loss status"; echo "csp_loss stop"
  # 4. wait out the RDP connection timeout, then verify on the clean link
  echo "sleep 12000"
  echo "crc32 -n $NODE -v 2 -f $PAY $REGION"
  echo "sleep 500"
  echo "download -n $NODE -v 2 -t 10000 $REGION $SIZE $GOT"
  echo "sleep 1000"
  echo "exit"
} > "$INIT"

echo ">> running (loss=$LOSS seed=$SEED); ~40 s ..."
timeout 500 script -qec "$CSH -i $INIT" /dev/null </dev/null 2>&1 \
  | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | tr -d '\r' > "$LOG"
rm -f "$INIT"

echo; echo "==================== VERDICT ===================="

# (a) region was exactly the sentinel before the lossy upload?
if cmp -s "$PRECHK" "$SENT"; then
  echo "[1] PRE-FILL CLEAN : region was exactly 0xAA before the run (no prior garbage; clean link delivered in full)"
else
  echo "[1] PRE-FILL DIRTY : region != sentinel before the run -- test INVALID, investigate"
  echo "    first diff:"; cmp "$PRECHK" "$SENT" 2>&1 | head -1; exit 2
fi

# (b) did the uploader claim success? The session runs TWO uploads (sentinel
# pre-fill first) -- the mechanism's claim is the SECOND upload's outcome.
up2=$(grep -aE "Uploaded $SIZE bytes|didn't complete" "$LOG" | sed -n '2p')
case "$up2" in
  *"Uploaded $SIZE bytes"*) echo "[2] CLAIMED SUCCESS: uploader printed 'Uploaded $SIZE bytes'";;
  *"didn't complete"*)      echo "[2] LOUD ABORT     : uploader admitted the failure -- not a silent cell";;
  *)                        echo "[2] NO CLAIM LINE  : inspect $LOG";;
esac

# (c) is the delivered file wrong?
GOT_SHA=$(sha256sum "$GOT" 2>/dev/null | cut -d' ' -f1)
if [ "$GOT_SHA" = "$ORIG_SHA" ]; then
  echo "[3] DELIVERED OK   : sha256 matches source -- no corruption this cell (try higher loss/another seed)"
  exit 0
fi
echo "[3] FILE WRONG     : delivered sha256 != source"

# (d) where does it go wrong, and is the wrong tail still the sentinel?
FIRST=$(cmp "$PAY" "$GOT" 2>/dev/null | grep -oE 'byte [0-9]+' | grep -oE '[0-9]+' | head -1)
echo "    first differing byte: ${FIRST:-?} of $SIZE  (a tail offset => truncation, not scattered damage)"
# tail of the delivered file, from the first difference on: all 0xAA ?
TAILHEX=$(tail -c "$((SIZE - ${FIRST:-0} + 1))" "$GOT" | od -v -An -tx1 | tr -d ' \n' | tr -d '\n')
if [ -n "$TAILHEX" ] && [ -z "$(echo "$TAILHEX" | sed 's/aa//g')" ]; then
  echo "[4] TAIL IS SENTINEL: every wrong byte is 0xAA -- these bytes were NEVER delivered by this upload."
  echo "    => silent corruption is the upload's own failure, not pre-existing garbage. PROVEN."
else
  echo "[4] tail is NOT all-0xAA -- wrong bytes are something other than the sentinel; inspect $GOT with: xxd $GOT | tail"
fi
echo; echo "artifacts: session=$LOG  delivered=$GOT  prefill-readback=$PRECHK"
