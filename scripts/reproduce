#!/usr/bin/env bash
#
# reproduce - build the instrument and run the regression suite that guards it.
#
# Requires only Docker. No CAN bus, no flatsat, no payload board, no vendor binaries.
# Everything runs inside a container; nothing touches the host's build tree.
#
#   scripts/reproduce            build + regression suite (~1 min)
#   scripts/reproduce test       same
#
# WHAT THIS COVERS
# The instrument and its regression suite are reproducible on any machine. The suite
# guards the instrument itself: the two-oracle agreement tests (injector drop-log vs
# live monitor), proxy determinism (same seed -> identical drop vector), and the
# half-duplex airtime model.
#
# WHAT IT DOES NOT
# Every transfer-mechanism measurement in this thesis was taken on the FlatSat's payload
# board over CAN and cannot be reproduced without the hardware. Those results are reported
# from committed data (see captures/ and the artifact appendix). The host-loopback arms
# that once ran here were scoped out with the board-only decision (docs/scope-board-only.md).
set -uo pipefail

MODE="${1:-test}"
REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO" || exit 1

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
rule() { printf '%s\n' "----------------------------------------------------------------------"; }

command -v docker >/dev/null 2>&1 || { echo "FAIL: docker not found. Install Docker Desktop."; exit 1; }
docker info >/dev/null 2>&1 || { echo "FAIL: docker is installed but not running. Start Docker Desktop."; exit 1; }

case "$MODE" in
  test|quick|full) : ;;  # quick/full accepted for compatibility; the arms are board-only now
  *) echo "usage: $0 [test]"; exit 2 ;;
esac

rule; bold "csp-linksim :: reproduce (instrument + regression suite)"; rule
echo "Everything below runs in a container. Host build tree untouched."
echo

bold "[1/2] Building the instrument"
scripts/bench build || { echo "FAIL: build failed"; exit 1; }
echo "  ok"
echo

bold "[2/2] Regression suite"
echo "  Includes the two-oracle agreement tests (injector drop-log vs live monitor),"
echo "  proxy determinism (same seed -> identical drop vector), and the half-duplex"
echo "  airtime model. These guard the instrument itself."
echo
scripts/bench test || { echo "FAIL: regression suite failed"; exit 1; }
echo

rule
bold "Suite complete."
echo "  The transfer-mechanism measurements are board-only (FlatSat payload board over"
echo "  CAN) and are reported from committed data:"
echo "  DTP / RDP / satdeploy comparison (4800 bit/s)   captures/{dtp,rdp,satdeploy}_experiment_2026-08.csv"
[ -d "$REPO/captures/board_external_full" ] && echo "  satdeploy + naive, payload board          captures/board_external_full/ (externally judged)"
rule
