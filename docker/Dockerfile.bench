# Linux bench environment for csp-intercept.
#
# The front-ends (proxy, monitor APM, injector, SVU) are Linux-only: they need libzmq,
# SocketCAN headers, and libcsp's Linux transport layer. This image is the reproducible
# way to build and run them from any host, including macOS, where the pure lib/ still
# builds natively but nothing else does.
#
# Build and run through scripts/bench, which wires the mounts:
#   scripts/bench build          # configure + compile the front-ends
#   scripts/bench test           # meson test suite
#   scripts/bench svu-zmq-sweep  # the host SVU arm, no CAN bus and no payload board
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
# The extra packages below are not needed by csp-intercept itself. They are the external
# dependencies of the MISSION sources this bench builds from outside the repo, so that the
# flatsat's software stack can be stood up in a container and later ported back to the
# board unchanged. None of that source is vendored here.
#
#   libprotobuf-c, libssl   DISCO's upload_gs-server / upload_sat-client (scripts/dtp-zmq-sweep)
#                           and satdeploy's agent + APM
#   tmux                    scripts/lab, the two-pane ground/board console
#   libcurl, libyaml,       csh itself (DISCOSAT/upload_gs-server/csh), which is the ground
#   libelf, libbsd,         side for the satdeploy arm: `satdeploy push` is a csh APM command,
#   libjxl, python3-dev     so there is no driving that arm without a built csh
RUN apt-get update -qq && apt-get install -y -qq \
    build-essential ninja-build pkg-config \
    libzmq3-dev libsocketcan-dev python3 git iproute2 procps coreutils \
    libprotobuf-c-dev protobuf-c-compiler libssl-dev \
    libcurl4-openssl-dev libyaml-dev libelf-dev libbsd-dev libjxl-dev python3-dev socat \
    libbrotli-dev \
    tmux python3-pip
# csh (flight, 2026-06) requires meson >= 1.6; Ubuntu 24.04 packages 1.3.2, so meson
# comes from pip instead of apt.
RUN pip3 install --break-system-packages 'meson>=1.6'
WORKDIR /src
